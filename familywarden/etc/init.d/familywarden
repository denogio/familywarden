#!/bin/sh /etc/rc.common

START=60

BIN="/usr/bin/familywarden"
CRON_FILE="/etc/crontabs/root"
CRON_MARKER="familywarden"

boot() {
    fw_start
}

start() {
    fw_start
}

stop() {
    fw_stop
}

reload() {
    $BIN reload
}

fw_start() {
    # Initialize nft chain and evaluate once
    $BIN init

    # Install cron job for periodic evaluation (every minute)
    mkdir -p $(dirname "$CRON_FILE")
    grep -q "$CRON_MARKER" "$CRON_FILE" 2>/dev/null || \
        echo "* * * * * $BIN eval # $CRON_MARKER" >> "$CRON_FILE"

    # Ensure cron is running
    /etc/init.d/cron start
}

fw_stop() {
    # Remove cron job
    if [ -f "$CRON_FILE" ]; then
        grep -v "$CRON_MARKER" "$CRON_FILE" > "${CRON_FILE}.tmp" 2>/dev/null || true
        mv "${CRON_FILE}.tmp" "$CRON_FILE" 2>/dev/null || true
    fi

    # Clear nft chain
    nft delete chain inet fw4 familywarden_forward 2>/dev/null || true
}
