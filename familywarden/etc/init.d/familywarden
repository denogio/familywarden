#!/bin/sh /etc/rc.common

# familywarden procd init script
# Triggers nftables include regeneration and fw4 reload on UCI changes

USE_PROCD=1
START=95
STOP=01

BIN="/usr/libexec/rpcd/familywarden"
FW_INCLUDE="/var/etc/familywarden.include"

start_service() {
    # Generate initial nftables include and apply via fw4
    $BIN reload
}

stop_service() {
    # Remove our include file and reload fw4 to clean up
    rm -f "$FW_INCLUDE"
    fw4 reload 2>/dev/null
}

reload_service() {
    $BIN reload
}

service_triggers() {
    procd_add_reload_trigger "familywarden"
}
