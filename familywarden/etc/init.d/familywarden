#!/bin/sh /etc/rc.common

START=60
USE_PROCD=1

BIN="/usr/bin/familywarden"

start_service() {
    procd_open_instance
    procd_set_param command "$BIN" eval
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_close_instance
}

stop_service() {
    true
}

reload_service() {
    $BIN reload
}
