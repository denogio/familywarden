# familywarden UCI configuration
# Remove this file before package install - it's a template only

config global 'settings'
    option enabled '1'
    option default_policy 'allow'
    # Ulysses: the captain profile that can make a pact, and the cooling-off
    # (hours) before "sailing home" on port 7700 releases it
    # option ulysses_profile 'dennis'
    option ulysses_delay '24'

