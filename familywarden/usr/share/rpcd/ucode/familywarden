'use strict';

import { popen } from 'fs';

function fw_call(...args) {
	let cmd = '/usr/bin/familywarden';
	for (let a in args)
		cmd += ' ' + a;

	let fd = popen(cmd + ' 2>&1');
	if (!fd)
		return { error: 'Failed to execute familywarden' };

	let output = fd.read('all');
	fd.close();

	try {
		return json(output);
	} catch(e) {
		return { error: 'Invalid JSON', raw: output };
	}
}

const methods = {
	list: {
		call: function() {
			return fw_call('list');
		}
	},

	status: {
		args: { profile: 'profile' },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('status', request.args.profile);
		}
	},

	traffic: {
		args: { profile: 'profile' },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('traffic', request.args.profile);
		}
	},

	block: {
		args: { profile: 'profile' },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('block', request.args.profile);
		}
	},

	allow: {
		args: { profile: 'profile' },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('allow', request.args.profile);
		}
	},

	reset: {
		args: { profile: 'profile' },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('reset', request.args.profile);
		}
	},

	ticket: {
		args: { profile: 'profile', minutes: 30 },
		call: function(request) {
			if (!request.args.profile)
				return { error: 'Missing profile argument' };
			return fw_call('ticket', request.args.profile, request.args.minutes ?? 30);
		}
	},

	reload: {
		call: function() {
			return fw_call('reload');
		}
	}
};

return { familywarden: methods };
