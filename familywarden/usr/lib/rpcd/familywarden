#!/bin/sh
# rpcd plugin for familywarden - generates nftables include from UCI config
#
# Architecture: fully declarative. Every state change triggers a full
# compile-and-apply pipeline that rebuilds the include file atomically.
#
#   read UCI + RAM state + GC expired tickets
#         ↓
#   compile /tmp/familywarden.include.new
#         ↓
#   nft -c -f ...   (validate)
#         ↓
#   mv ... /var/etc/familywarden.include   (atomic)
#         ↓
#   fw4 reload
#
# No direct nft mutations, no rule handles, no background processes.
# The 100-300ms cost of fw4 reload is acceptable for parental control.

. /usr/share/libubox/jshn.sh
. /lib/functions.sh

FW_CONFIG="/etc/config/familywarden"
FW_STATE="/tmp/familywarden.state"
FW_INCLUDE="/var/etc/familywarden.include"
FW_INCLUDE_NEW="/tmp/familywarden.include.new"
FW_LOCK="/var/lock/familywarden.lock"
FW_CHAIN="familywarden_forward"
# Input hook: drops incoming TCP to the router itself (LuCI, SSH, etc.) for
# profiles with block_router='1' while they are in an effective blocked state.
# Matched by source MAC, so it works regardless of the router's LAN IP
# (192.168.1.1, 192.168.0.1, 10.0.0.1, ...).
FW_CHAIN_INPUT="familywarden_input"

# Ulysses state. Persistent (survives reboot) so rebooting is not a way out.
FW_PERSIST="/etc/familywarden"
FW_PACT="$FW_PERSIST/pact"
FW_PACT_SNAP="$FW_PERSIST/pact.snap"
FW_RELEASE="$FW_PERSIST/release"
# The captain's DNS settings when the pact was made: during the pact DNS can
# only be tightened (snapshot + whatever is added since), never loosened.
FW_PACT_DNS="$FW_PERSIST/pact.dns"
# The sail page (separate uhttpd instance): the only way out of a pact, and
# the only router port left open during a lockdown
FW_SAIL_PORT=7700
# Effective config: UCI with the captain replaced by the pact snapshot.
# Everything that enforces or reports reads this (fw_load).
FW_EFFECTIVE_DIR="/var/run/familywarden"
# Ulysses Mast (Android device-owner app on the captain's phone): signs what it
# fetches with this usign (Ed25519) key, so the phone can't be fed a fake "no
# pact". Generated on first use, persistent.
FW_MAST_KEY="$FW_PERSIST/mast.key"
FW_MAST_PUB="$FW_PERSIST/mast.pub"
FW_MAST_SEEN="/tmp/familywarden.mast"
# FamilyWarden app (v2): phones enroll with their own usign key and wait in
# RAM until approved in LuCI; approved phones are UCI "device" sections.
FW_PENDING="/tmp/familywarden.pending"
FW_SEEN_DIR="/tmp/familywarden.seen"
FW_PENDING_MAX=10
# AdGuard Home management (see "DNS: AdGuard Home sync")
FW_AGH_AUTH="$FW_PERSIST/agh.auth"
FW_AGH_OWNED="$FW_PERSIST/agh.owned"
FW_DNS_ACK="$FW_PERSIST/dns.ack"
FW_DNS_DIRTY="/tmp/familywarden.dns.dirty"
FW_DNS_STATUS="/tmp/familywarden.dns.status"
FW_DNS_LOCK="/var/lock/familywarden.dns.lock"

# ---- Helpers ----

# Day name to number: sun=0, mon=1, ..., sat=6
day_to_num() {
    case "$1" in
        sun) echo "0" ;;
        mon) echo "1" ;;
        tue) echo "2" ;;
        wed) echo "3" ;;
        thu) echo "4" ;;
        fri) echo "5" ;;
        sat) echo "6" ;;
        *)   echo "" ;;
    esac
}

# Shift day number by +1 mod 7
day_shift() {
    echo $(( ($1 + 1) % 7 ))
}

# Convert HH:MM to minutes since midnight
time_to_minutes() {
    local h="${1%%:*}" m="${1#*:}"
    h="${h#0}" && [ -z "$h" ] && h=0
    m="${m#0}" && [ -z "$m" ] && m=0
    echo $(( h * 60 + m ))
}

# ---- Current-time schedule evaluation (status reporting) ----
#
# Mirror of the nft rule generation in _sched_accept_rules: decide whether
# "now" (current weekday + minutes-since-midnight) falls inside one of a
# profile's allow-windows, so reported status matches the firewall. Set
# _now_profile/_now_day/_now_min before iterating; _now_allowed=1 on a match.
_now_profile=""; _now_day=""; _now_min=""; _now_allowed=0

_now_match_schedule() {
    local sched="$1" sp days start stop smin emin d n
    config_get sp "$sched" profile ""
    [ "$sp" = "$_now_profile" ] || return
    config_get days "$sched" days ""
    config_get start "$sched" start ""
    config_get stop "$sched" stop ""
    [ -z "$days" ] || [ -z "$start" ] || [ -z "$stop" ] && return
    smin=$(time_to_minutes "$start"); emin=$(time_to_minutes "$stop")
    for d in $days; do
        n=$(day_to_num "$d"); [ -z "$n" ] && continue
        if [ "$smin" -lt "$emin" ]; then
            [ "$n" = "$_now_day" ] && [ "$_now_min" -ge "$smin" ] && [ "$_now_min" -lt "$emin" ] && _now_allowed=1
        elif [ "$smin" -gt "$emin" ]; then
            # Overnight: start..24:00 on the day, 00:00..stop on the next day
            [ "$n" = "$_now_day" ] && [ "$_now_min" -ge "$smin" ] && _now_allowed=1
            [ "$(day_shift "$n")" = "$_now_day" ] && [ "$_now_min" -lt "$emin" ] && _now_allowed=1
        else
            # start==stop → allowed all day on those days
            [ "$n" = "$_now_day" ] && _now_allowed=1
        fi
    done
}

# Canonical effective status: always "allowed" or "blocked" (frontend matches
# on the substring "blocked"). Requires `fw_load` beforehand.
profile_effective_status() {
    local profile="$1" policy="$2" override="$3"
    fw_enabled || { echo "allowed"; return; }
    case "$override" in
        allow) echo "allowed"; return ;;
        block) echo "blocked"; return ;;
    esac
    case "$policy" in
        block) echo "blocked" ;;
        scheduled)
            _now_profile="$profile"; _now_allowed=0
            _now_day=$(date +%w)                       # 0=sun..6=sat (matches day_to_num)
            _now_min=$(time_to_minutes "$(date +%H:%M)")
            config_foreach _now_match_schedule schedule
            [ "$_now_allowed" = "1" ] && echo "allowed" || echo "blocked"
            ;;
        *) echo "allowed" ;;
    esac
}

# State file helpers
state_set() {
    local key="$1"
    local value="$2"
    mkdir -p "$(dirname "${FW_STATE}")"
    sed -i "/^${key}=/d" "${FW_STATE}" 2>/dev/null
    echo "${key}=${value}" >> "${FW_STATE}"
}

state_get() {
    local key="$1"
    local default="${2:-}"
    local line
    line=$(grep "^${key}=" "${FW_STATE}" 2>/dev/null) || { echo "$default"; return; }
    echo "${line#*=}"
}

# Echo "<override> <expires>" for a profile with expiry applied at read time:
# an expired ticket (allow with override_expires in the past) reads as "none".
# This makes status reporting correct the instant a ticket lapses, independent
# of any firewall recompile — the kernel removes the nft set element on its own.
effective_override() {
    local profile="$1" o e
    o=$(state_get "${profile}.override" "none")
    e=$(state_get "${profile}.override_expires" "")
    if [ -n "$e" ] && [ "$o" != "none" ] && [ "$(date +%s)" -gt "$e" ]; then
        echo "none "
        return
    fi
    echo "$o $e"
}

# GC expired ticket overrides. Called at start of compile_and_apply.
# Returns 1 if any state was changed (caller should recompile).
gc_expired_tickets() {
    local now
    now=$(date +%s)
    local changed=0
    local key expires_epoch

    [ -f "${FW_STATE}" ] || return 0

    for key in $(grep -o '^[^.]*\.override_expires=[0-9]*' "${FW_STATE}" 2>/dev/null | cut -d= -f1); do
        expires_epoch=$(state_get "${key}" "")
        if [ -n "$expires_epoch" ] && [ "$now" -gt "$expires_epoch" ]; then
            local profile="${key%.override_expires}"
            state_set "${profile}.override" "none"
            state_set "${profile}.override_expires" ""
            changed=1
        fi
    done

    return $changed
}

# ---- Ulysses: the captain's pact ----
#
# One profile is the captain (settings.ulysses_profile). The captain can make a
# pact, stored in $FW_PACT (key=value). For the pact's lifetime:
#   - the captain's profile is frozen: enforcement uses a snapshot taken when
#     the pact was made ($FW_PACT_SNAP); UCI edits are ignored, except during
#     an ongoing pact's weekly amendment window, where they apply at once
#   - allow and ticket are refused for the captain, and the captain's MACs are
#     stripped from every other profile, so no other profile can let them out
#   - while the captain is blocked, all TCP to the router is dropped for every
#     device except DNS and the sail page on $FW_SAIL_PORT (familywarden_lockdown)
# A pact is either "until" (ends at an epoch; can only be extended) or
# "ongoing" (no end; weekly window). The only way out early is the sail page:
# root password + the line from Josh Garrels' "Ulysses", then the cooling-off
# frozen into the pact ("delay") must pass.

# Single-quote a value for a UCI config file
_q() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

_frag_dev() {
    echo "	list device $(_q "$1")"
}

_frag_always() {
    echo "	list always_allowed $(_q "$1")"
}

# An approved phone bound to the profile being snapshotted: frozen with it, so
# moving or deleting the captain's phone in LuCI is no way out of a pact.
_frag_phone() {
    local s="$1" sp o v
    config_get sp "$s" profile ""
    [ "$sp" = "$_frag_profile" ] || return
    config_get v "$s" id ""
    [ -n "$v" ] || return
    echo "config device '$s'"
    for o in id name profile pubkey administrator; do
        config_get v "$s" "$o" ""
        [ -n "$v" ] && echo "	option $o $(_q "$v")"
    done
}

_frag_sched_line() {
    local s="$1" sp days start stop
    config_get sp "$s" profile ""
    [ "$sp" = "$_frag_profile" ] || return
    config_get days "$s" days ""
    config_get start "$s" start ""
    config_get stop "$s" stop ""
    echo "${days}|${start}|${stop}"
}

# Print the enforcement-relevant config of a profile (enabled, policy,
# block_router, devices, schedules, app rules) from the currently loaded config,
# as UCI sections. Empty if the profile doesn't exist.
profile_fragment() {
    local p="$1" type o v n=0 days start stop kind a b c
    config_get type "$p" TYPE ""
    [ "$type" = "profile" ] || return 0
    echo "config profile '$p'"
    for o in enabled policy block_router apps apps_suspend_new screen_minutes screen_weekday screen_weekend; do
        config_get v "$p" "$o" ""
        [ -n "$v" ] && echo "	option $o $(_q "$v")"
    done
    config_list_foreach "$p" always_allowed _frag_always | sort
    config_list_foreach "$p" device _frag_dev | sort
    _frag_profile="$p"
    config_foreach _frag_phone device
    config_foreach _frag_sched_line schedule | sort | while IFS='|' read -r days start stop; do
        n=$((n + 1))
        echo "config schedule '${p}_pact${n}'"
        echo "	option profile '$p'"
        echo "	option days $(_q "$days")"
        echo "	option start $(_q "$start")"
        echo "	option stop $(_q "$stop")"
    done
    # App rules are frozen with the pact too: live app sections of the captain are
    # dropped from the effective config, so leaving them out would loosen them.
    n=0
    _apps_canon "$p" | while IFS='|' read -r kind a b c; do
        n=$((n + 1))
        case "$kind" in
            app)
                echo "config app '${p}_pactapp${n}'"
                echo "	option profile '$p'"
                echo "	option package $(_q "$a")"
                [ -n "$b" ] && echo "	option minutes $(_q "$b")"
                echo "	option blocked $(_q "$c")"
                ;;
            down)
                echo "config app_downtime '${p}_pactdown${n}'"
                echo "	option profile '$p'"
                echo "	option days $(_q "$a")"
                echo "	option start $(_q "$b")"
                echo "	option stop $(_q "$c")"
                ;;
        esac
    done
}

# ---- App control policy (wire v3) ----
#
# UCI: profile options apps (0/1) and apps_suspend_new (0/1, default 1, decision
# A12); config app (profile, package, minutes = daily limit, blocked) and config
# app_downtime (profile, days, start, stop) sections.

_valid_package() {
    case "$1" in ''|*[!A-Za-z0-9_.]*|*.|*..*) return 1 ;; esac
    case "$1" in [A-Za-z]*.*) ;; *) return 1 ;; esac
    [ "${#1}" -le 255 ]
}

_apps_line_cb() {
    local s="$1" p pkg min blk
    config_get p "$s" profile ""
    [ "$p" = "$_apps_profile" ] || return 0
    config_get pkg "$s" package ""
    _valid_package "$pkg" || { logger -t familywarden "app rule $s: invalid package ignored"; return 0; }
    config_get min "$s" minutes ""
    case "$min" in
        '') ;;
        *[!0-9]*) logger -t familywarden "app rule $s: invalid minutes, blocking $pkg"; min=0 ;;
        *) [ "${#min}" -le 4 ] && [ "$min" -le 1440 ] || min=1440 ;;
    esac
    config_get blk "$s" blocked "0"
    [ "$blk" = "1" ] || blk=0
    echo "app|$pkg|$min|$blk"
}

_apps_down_cb() {
    local s="$1" p days start stop d
    config_get p "$s" profile ""
    [ "$p" = "$_apps_profile" ] || return 0
    config_get days "$s" days ""
    config_get start "$s" start ""
    config_get stop "$s" stop ""
    for d in $days; do
        case "$d" in mon|tue|wed|thu|fri|sat|sun) ;; *) days="" ;; esac
    done
    if [ -z "$days" ] || ! echo "$start $stop" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9] ([01][0-9]|2[0-3]):[0-5][0-9]$'; then
        logger -t familywarden "app downtime $s: invalid, ignored"
        return 0
    fi
    echo "down|$(echo $days)|$start|$stop"
}

# Canonical, sorted app policy of a profile, one rule per line (empty when app
# control is off). Duplicate packages merge to the strictest rule: blocked wins,
# the smallest limit wins. The revision is a hash of exactly these lines.
# Needs a loaded config.
_apps_canon() {
    local on susp
    config_get on "$1" apps "0"
    [ "$on" = "1" ] || return 0
    config_get susp "$1" apps_suspend_new "1"
    [ "$susp" = "0" ] || susp=1
    _apps_profile="$1"
    {
        echo "new|$susp||"
        config_foreach _apps_line_cb app
        config_foreach _apps_down_cb app_downtime
        _apps_screen_lines "$1"
        config_list_foreach "$1" always_allowed _apps_always_cb
    } | awk -F'|' '
        $1 == "app" {
            if (!($2 in seen)) { seen[$2] = 1; min[$2] = $3; blk[$2] = $4; next }
            if ($4 == 1) blk[$2] = 1
            if ($3 != "" && (min[$2] == "" || $3 + 0 < min[$2] + 0)) min[$2] = $3
            next
        }
        { print }
        END { for (p in seen) print "app|" p "|" min[p] "|" blk[p] }' | sort -u
}

# Daily total screen time (D9): one value for all days, or weekday/weekend values
# that override it. Expanded per weekday so the phone decides offline.
_valid_minutes() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 4 ] && [ "$1" -le 1440 ]
}

_apps_screen_lines() {
    local all wd we d v
    config_get all "$1" screen_minutes ""
    config_get wd "$1" screen_weekday ""
    config_get we "$1" screen_weekend ""
    for d in mon tue wed thu fri sat sun; do
        case "$d" in sat|sun) v=${we:-$all} ;; *) v=${wd:-$all} ;; esac
        [ -n "$v" ] || continue
        if _valid_minutes "$v"; then echo "screen|$d|$v|"
        else logger -t familywarden "screen time of $1: invalid minutes '$v' ignored"; fi
    done
}

_apps_always_cb() {
    _valid_package "$1" && echo "always|$1||" || logger -t familywarden "always_allowed: invalid package ignored"
}

# Bonus for today (D9): "profile|day|target|minutes" lines, target = total or a package.
# Persistent (a router reboot must not take back given time); old days are dropped.
FW_BONUS="$FW_PERSIST/bonus"

_bonus_today() {
    local today
    today=$(date +%F)
    [ -s "$FW_BONUS" ] || return 0
    awk -F'|' -v p="$1" -v d="$today" '$1 == p && $2 == d { print "bonus|" $3 "|" $4 "|" d }' "$FW_BONUS" | sort
}

# Revision of what the phone must apply: the rules plus today's bonus.
_apps_rev() {
    local lines
    lines=$(_apps_canon "$1")
    [ -n "$lines" ] && printf '%s\n%s\n' "$lines" "$(_bonus_today "$1")" | sha256sum | cut -c1-16
}

# Add the "apps" object for a profile (nothing when app control is off). Loops read
# here-documents, not pipes: jshn state set in a pipeline subshell would be lost.
# Needs a loaded config and an open json_init.
_json_apps() {
    local lines kind a b c
    lines=$(_apps_canon "$1")
    [ -n "$lines" ] || return 0
    json_add_object "apps"
    json_add_string "rev" "$(_apps_rev "$1")"
    json_add_boolean "suspend_new" "$(echo "$lines" | sed -n 's/^new|\([01]\)||$/\1/p')"
    json_add_array "limits"
    while IFS='|' read -r kind a b c; do
        [ "$kind" = "app" ] && [ -n "$b" ] && [ "$c" = "0" ] || continue
        json_add_object ""
        json_add_string "package" "$a"
        json_add_int "minutes" "$b"
        json_close_object
    done <<EOF
$lines
EOF
    json_close_array
    json_add_array "blocked"
    while IFS='|' read -r kind a b c; do
        [ "$kind" = "app" ] && [ "$c" = "1" ] && json_add_string "" "$a"
    done <<EOF
$lines
EOF
    json_close_array
    # Approved = every configured package that is not blocked (limited ones too)
    json_add_array "approved"
    while IFS='|' read -r kind a b c; do
        [ "$kind" = "app" ] && [ "$c" = "0" ] && json_add_string "" "$a"
    done <<EOF
$lines
EOF
    json_close_array
    json_add_array "downtime"
    while IFS='|' read -r kind a b c; do
        [ "$kind" = "down" ] || continue
        json_add_object ""
        json_add_string "days" "$a"
        json_add_string "start" "$b"
        json_add_string "stop" "$c"
        json_close_object
    done <<EOF
$lines
EOF
    json_close_array
    if echo "$lines" | grep -q '^screen|'; then
        json_add_object "screen"
        while IFS='|' read -r kind a b c; do
            [ "$kind" = "screen" ] && json_add_int "$a" "$b"
        done <<EOF
$lines
EOF
        json_close_object
    fi
    json_add_array "always_allowed"
    while IFS='|' read -r kind a b c; do
        [ "$kind" = "always" ] && json_add_string "" "$a"
    done <<EOF
$lines
EOF
    json_close_array
    local bonus
    bonus=$(_bonus_today "$1")
    if [ -n "$bonus" ]; then
        json_add_object "bonus"
        json_add_string "day" "$(date +%F)"
        json_add_int "total" "$(echo "$bonus" | awk -F'|' '$2 == "total" { print $3 }' | head -1 | grep . || echo 0)"
        json_add_array "apps"
        while IFS='|' read -r kind a b c; do
            [ "$kind" = "bonus" ] && [ "$a" != "total" ] || continue
            json_add_object ""
            json_add_string "package" "$a"
            json_add_int "minutes" "$b"
            json_close_object
        done <<EOF
$bonus
EOF
        json_close_array
        json_close_object
    fi
    json_close_object
}

# Bonus time for today (Family Link "Bonus time"), total or one app. Adds up; at most
# 240 minutes per call and 1440 per target and day. Never changes the standing limits.
# Refused for a Ulysses captain under a pact: adults get no self-approval (A4).
ubus_bonus() {
    local profile="$1" minutes="$2" target="${3:-total}" on name today total
    case "$minutes" in ''|*[!0-9]*) _json_error "minutes must be 1..240"; return 1 ;; esac
    minutes=$(echo "$minutes" | sed 's/^0*//')
    [ "${minutes:-0}" -ge 1 ] 2>/dev/null && [ "$minutes" -le 240 ] || { _json_error "minutes must be 1..240"; return 1; }
    [ "$target" = "total" ] || _valid_package "$target" || { _json_error "invalid package"; return 1; }
    (
        flock -x 201 || { _json_error "bonus lock failed"; return 1; }
        fw_load
        config_get name "$profile" name ""
        [ -n "$name" ] || { _json_error "profile not found"; return 1; }
        config_get on "$profile" apps "0"
        [ "$on" = "1" ] || { _json_error "app control is off for this profile"; return 1; }
        _refuse_if_bound "$profile" && return 1
        today=$(date +%F)
        mkdir -p "$FW_PERSIST"
        # Keep other entries of today and later; drop old days; add up this target.
        if [ -f "$FW_BONUS" ]; then
            total=$(awk -F'|' -v p="$profile" -v d="$today" -v t="$target" -v m="$minutes" '
                $1 == p && $2 == d && $3 == t { m += $4 } END { print m }' "$FW_BONUS")
            awk -F'|' -v p="$profile" -v d="$today" -v t="$target" '
                $2 >= d && !($1 == p && $2 == d && $3 == t)' "$FW_BONUS" > "$FW_BONUS.new"
        else
            total=$minutes
            : > "$FW_BONUS.new"
        fi
        [ "$total" -le 1440 ] || total=1440
        echo "$profile|$today|$target|$total" >> "$FW_BONUS.new"
        mv "$FW_BONUS.new" "$FW_BONUS"
        logger -t familywarden "bonus: $profile +$minutes min ($target), $total min today"
        json_init
        json_add_string "status" "ok"
        json_add_string "profile" "$profile"
        json_add_string "target" "$target"
        json_add_int "minutes_today" "$total"
        json_dump
    ) 201>"${FW_LOCK}.bonus"
}

pact_get() {
    sed -n "s/^$1=//p" "$FW_PACT" 2>/dev/null
}

pact_active() {
    [ -f "$FW_PACT" ] || return 1
    [ "$(pact_get type)" = "ongoing" ] && return 0
    [ "$(pact_get until)" -gt "$(date +%s)" ] 2>/dev/null
}

# The captain bound by an active pact (empty if none)
pact_captain() {
    pact_active && pact_get captain
}

# Inside an ongoing pact's weekly amendment window right now?
pact_in_window() {
    [ "$(pact_get type)" = "ongoing" ] || return 1
    local d s e now
    d=$(day_to_num "$(pact_get window_day)")
    s=$(time_to_minutes "$(pact_get window_start)")
    e=$(time_to_minutes "$(pact_get window_stop)")
    now=$(time_to_minutes "$(date +%H:%M)")
    [ "$(date +%w)" = "$d" ] && [ "$now" -ge "$s" ] && [ "$now" -lt "$e" ]
}

# Epoch the sail page's release takes effect (0 = not requested)
release_at() {
    cat "$FW_RELEASE" 2>/dev/null || echo 0
}

# End the pact when it expired or a requested release is due
gc_pact() {
    [ -f "$FW_PACT" ] || { rm -f "$FW_PACT_SNAP" "$FW_RELEASE"; return 0; }
    local rel
    rel=$(release_at)
    if [ "$rel" != "0" ] && [ "$(date +%s)" -ge "$rel" ]; then
        rm -f "$FW_PACT" "$FW_PACT_SNAP" "$FW_RELEASE" "$FW_PACT_DNS"
        touch "$FW_DNS_DIRTY"
        logger -t familywarden "Ulysses: released from the mast (sail page)"
    elif ! pact_active; then
        rm -f "$FW_PACT" "$FW_PACT_SNAP" "$FW_RELEASE" "$FW_PACT_DNS"
        touch "$FW_DNS_DIRTY"
        logger -t familywarden "Ulysses: pact ended"
    fi
}

# Snapshot the captain's DNS settings (live UCI must be loaded): "key=value" lines
pact_dns_snapshot() {
    local p="$1" v
    {
        config_get v "$p" dns "0"
        echo "dns=$v"
        config_get v "$p" dns_client_id ""
        echo "id=$v"
        config_get v settings dns_domain ""
        echo "domain=$v"
        config_list_foreach "$p" dns_protection _pds_prot
        config_list_foreach "$p" dns_service _pds_svc
    } > "$FW_PACT_DNS.new"
    mv "$FW_PACT_DNS.new" "$FW_PACT_DNS"
}
_pds_prot() { echo "prot=$1"; }
_pds_svc() { echo "svc=$1"; }

# Drop allow overrides and tickets: they must not survive into a pact
_clear_allow() {
    [ "$(state_get "$1.override" none)" = "allow" ] || return 0
    state_set "$1.override" "none"
    state_set "$1.override_expires" ""
}

# Write the effective config: UCI with the captain replaced by the pact
# snapshot (refreshed from UCI inside the amendment window) and the captain's
# MACs removed from every other profile. Called by compile_and_apply under the
# exclusive lock; all enforcement and reporting reads it via fw_load.
ulysses_sync() {
    local captain="" macs="" ids="" name
    mkdir -p "$FW_EFFECTIVE_DIR"
    config_load familywarden

    if pact_active; then
        captain=$(pact_get captain)
        [ -f "$FW_PACT_DNS" ] || pact_dns_snapshot "$captain"
        if [ ! -s "$FW_PACT_SNAP" ]; then
            profile_fragment "$captain" > "$FW_PACT_SNAP"
        elif pact_in_window; then
            # The amendment window may loosen DNS too
            pact_dns_snapshot "$captain"
            touch "$FW_DNS_DIRTY"
            # Rule amendments must not refresh away a frozen phone association.
            awk '/^config / { phone = ($2 == "device") } phone' "$FW_PACT_SNAP" > "$FW_PACT_SNAP.phones"
            profile_fragment "$captain" | awk '/^config / { phone = ($2 == "device") } !phone' > "$FW_PACT_SNAP.new"
            cat "$FW_PACT_SNAP.phones" >> "$FW_PACT_SNAP.new"
            mv "$FW_PACT_SNAP.new" "$FW_PACT_SNAP"
            rm -f "$FW_PACT_SNAP.phones"
        fi
        macs=$(sed -n "s/^	list device '\(.*\)'$/\1/p" "$FW_PACT_SNAP" | tr 'A-F' 'a-f' | tr '\n' ' ')
        ids=$(sed -n "s/^	option id '\(.*\)'$/\1/p" "$FW_PACT_SNAP" | tr '\n' ' ')
    fi

    {
        uci -q export familywarden | awk -v cap="$captain" -v macs=" $macs " -v ids=" $ids " '
            function flush() { if (!drop) printf "%s", blk; blk = ""; drop = 0 }
            function unq(s) { gsub("\047", "", s); return s }
            /^config / { flush(); prof = ""; type = $2; if ($2 == "profile") { prof = unq($3); if (cap != "" && prof == cap) drop = 1 } }
            cap != "" && /^[ \t]*option profile / { if (unq($3) == cap) drop = 1 }
            cap != "" && type == "device" && /^[ \t]*option id / { if (index(ids, " " unq($3) " ")) drop = 1 }
            cap != "" && prof != "" && /^[ \t]*list device / { if (index(macs, " " tolower(unq($3)) " ")) next }
            { blk = blk $0 "\n" }
            END { flush() }'
        if [ -n "$captain" ] && [ -s "$FW_PACT_SNAP" ]; then
            config_get name "$captain" name "$captain"
            echo "config profile '$captain'"
            echo "	option name $(_q "$name")"
            sed 1d "$FW_PACT_SNAP"
        fi
    } > "$FW_EFFECTIVE_DIR/familywarden.new"
    mv "$FW_EFFECTIVE_DIR/familywarden.new" "$FW_EFFECTIVE_DIR/familywarden"
}

# config_load from the effective config (falls back to UCI before the first
# compile has written it)
fw_load() {
    if [ -f "$FW_EFFECTIVE_DIR/familywarden" ]; then
        UCI_CONFIG_DIR="$FW_EFFECTIVE_DIR"
        config_load familywarden
        unset UCI_CONFIG_DIR
    else
        config_load familywarden
    fi
}

# ---- Global settings ----
#
# settings.enabled='0' turns all enforcement off; settings.default_policy
# decides what happens to devices that are in no profile. Both are frozen
# during a Ulysses pact (otherwise switching FamilyWarden off, or letting
# unknown devices through, would be a way out): enabled counts as '1', and
# default_policy is the value stored in the pact. Require fw_load.

fw_enabled() {
    pact_active && return 0
    local enabled
    config_get enabled settings enabled "1"
    [ "$enabled" = "1" ]
}

fw_default_policy() {
    local policy=""
    pact_active && policy=$(pact_get default_policy)
    [ -n "$policy" ] || config_get policy settings default_policy "allow"
    echo "$policy"
}

_collect_all_mac() {
    _all_macs="$_all_macs, $1"
}

_collect_profile_macs() {
    config_list_foreach "$1" device _collect_all_mac
}

# Devices of the firewall's "lan" zone, one per line. Asks fw4 (via netifd);
# falls back to the zone's networks' "device" options in UCI when netifd has
# no answer (early boot, containers).
lan_devices() {
    local devs sec net
    devs=$(fw4 -q zone lan 2>/dev/null)
    if [ -z "$devs" ]; then
        sec=$(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='lan'$/\1/p" | head -1)
        for net in $(uci -q get "firewall.$sec.network"); do
            uci -q get "network.$net.device"
        done
    else
        echo "$devs"
    fi
}

# default_policy='block': drop forwarded traffic coming in on the LAN from any
# MAC that is in no profile (enabled or not), e.g. a new laptop. Only traffic
# entering on the LAN zone's devices, so replies from the internet (source MAC
# = the upstream router) are never matched.
gen_default_policy_rule() {
    [ "$(fw_default_policy)" = "block" ] || return 0
    local lan saddr=""
    lan=$(lan_devices | sed 's/.*/"&"/' | tr '\n' ',' | sed 's/,$//; s/,/, /g')
    if [ -z "$lan" ]; then
        logger -t familywarden "default_policy=block: no LAN devices found (fw4 zone lan), not applied"
        return 0
    fi
    _all_macs=""
    config_foreach _collect_profile_macs profile
    _all_macs="${_all_macs#, }"
    [ -n "$_all_macs" ] && saddr="ether saddr != { ${_all_macs} } "
    echo "        iifname { ${lan} } ${saddr}counter drop comment \"familywarden:default:block\""
}

# Allow/ticket are refused for the captain during a pact
_refuse_if_bound() {
    [ -n "$1" ] && [ "$1" = "$(pact_captain)" ] || return 1
    json_init
    json_add_string "error" "bound by Ulysses pact"
    json_add_int "pact_until" "$(pact_get until)"
    json_dump
    return 0
}

_is_captain_bound() {
    [ -n "$1" ] && [ "$1" = "$(pact_captain)" ]
}

# familywarden_lockdown body: while the captain is blocked, drop all TCP to
# the router except DNS and the sail page. Mirrors the captain's forward rules:
# accept inside the captain's allow windows (and the amendment window), then
# drop. Requires fw_load. Empty without an active pact.
gen_lockdown_rules() {
    local captain enabled policy override until wd
    captain=$(pact_captain)
    [ -n "$captain" ] || return 0
    config_get enabled "$captain" enabled "0"
    config_get policy "$captain" policy "allow"
    override=$(state_get "${captain}.override" "none")
    # A captain that is never blocked never locks the router down
    [ "$enabled" = "1" ] || return 0
    [ "$policy" = "allow" ] && [ "$override" != "block" ] && return 0

    echo "        iifname \"lo\" accept"
    echo "        ct state established,related accept"
    echo "        tcp dport { 53, ${FW_SAIL_PORT} } accept"
    if [ "$(pact_get type)" = "ongoing" ]; then
        wd=$(day_to_num "$(pact_get window_day)")
        echo "        meta day { ${wd} } meta hour >= $(pact_get window_start) meta hour < $(pact_get window_stop) accept comment \"familywarden:ulysses:window\""
    fi
    if [ "$policy" = "scheduled" ] && [ "$override" != "block" ]; then
        _cur_profile="$captain"
        _sched_devices="any"
        _sched_tag=":lockdown"
        config_foreach _sched_accept_rules schedule
        _sched_tag=""
    fi
    until=""
    [ "$(pact_get type)" = "until" ] && until="meta time < $(pact_get until) "
    echo "        meta l4proto tcp ${until}counter drop comment \"familywarden:ulysses:lockdown\""
}

# ---- Rule generators (write to FW_INCLUDE_NEW) ----
#
# Schedules are ALLOW-windows: a scheduled profile is blocked by default and
# only allowed inside its windows ("blocks by default and only allows access
# during the time windows").
#
# Model: for each device, emit accept rules for every allow-window, then a
# trailing default-drop. Rules in the chain are matched top-to-bottom and
# accept/drop are terminal, so inside a window the device is accepted and
# everything else falls through to the drop. Multiple/overlapping windows
# just OR together (no merging needed). Override accept rules are emitted
# earlier in the chain, so a temporary allow still wins over the default drop.

# Emit accept rules for one schedule's window(s), for every device of the
# current profile. Overnight windows (start>stop) split at midnight onto the
# next weekday. Shared by both chains: the input chain sets _sched_match
# (extra match, e.g. "tcp dport 0-65535 ") and _sched_tag (comment suffix).
_sched_match=""; _sched_tag=""
_sched_accept_rules() {
    local sched="$1"
    local sched_profile days start stop
    config_get sched_profile "$sched" profile ""
    [ "$sched_profile" = "$_cur_profile" ] || return
    config_get days "$sched" days ""
    config_get start "$sched" start ""
    config_get stop "$sched" stop ""
    [ -z "$days" ] || [ -z "$start" ] || [ -z "$stop" ] && return

    local day_nums="" shifted_nums="" d n
    for d in $days; do
        n=$(day_to_num "$d")
        [ -z "$n" ] && continue
        day_nums="$day_nums, $n"
        shifted_nums="$shifted_nums, $(day_shift "$n")"
    done
    day_nums="${day_nums#, }"
    shifted_nums="${shifted_nums#, }"
    [ -z "$day_nums" ] && return

    local smin emin mac src
    smin=$(time_to_minutes "$start")
    emin=$(time_to_minutes "$stop")
    for mac in $_sched_devices; do
        # "any" = every source (familywarden_lockdown)
        src="ether saddr ${mac} "
        [ "$mac" = "any" ] && src=""
        if [ "$smin" -lt "$emin" ]; then
            echo "        ${src}meta hour >= ${start} meta hour < ${stop} meta day { ${day_nums} } ${_sched_match}counter accept comment \"familywarden:${_cur_profile}:sched-allow${_sched_tag}\""
        elif [ "$smin" -gt "$emin" ]; then
            # Overnight: allow start..24:00 on the day, 00:00..stop on next day
            echo "        ${src}meta hour >= ${start} meta day { ${day_nums} } ${_sched_match}counter accept comment \"familywarden:${_cur_profile}:sched-allow${_sched_tag}\""
            echo "        ${src}meta hour < ${stop} meta day { ${shifted_nums} } ${_sched_match}counter accept comment \"familywarden:${_cur_profile}:sched-allow${_sched_tag}\""
        else
            # start==stop → allow all day on those days
            echo "        ${src}meta day { ${day_nums} } ${_sched_match}counter accept comment \"familywarden:${_cur_profile}:sched-allow${_sched_tag}\""
        fi
    done
}

# Echo nftables override rules (block/allow) for a profile
gen_override_rules() {
    local section="$1"
    local enabled override override_expires

    config_get enabled "$section" enabled "0"
    [ "$enabled" != "1" ] && return

    override=$(state_get "${section}.override" "none")
    [ "$override" = "none" ] && return
    [ "$override" = "allow" ] && _is_captain_bound "$section" && return

    # A timed allow (ticket) is handled by the familywarden_ticket timeout set so
    # the kernel can expire it on its own — never emit it as a static rule here.
    # Permanent block, and permanent allow (no expiry), stay as static rules.
    override_expires=$(state_get "${section}.override_expires" "")
    [ "$override" = "allow" ] && [ -n "$override_expires" ] && return

    _cur_profile="$section"
    _override_target="$override"
    config_list_foreach "$section" device gen_device_override_rule
}

gen_device_override_rule() {
    local mac="$1"
    local action="drop"
    [ "$_override_target" = "allow" ] && action="accept"
    echo "        ether saddr ${mac} counter ${action} comment \"familywarden:${_cur_profile}:override:${_override_target}\""
}

# Echo drop rules for a profile permanently set to policy=block.
# Override rules are emitted earlier, so an active allow-override (accept)
# matches first and wins over this drop.
gen_profile_block() {
    local section="$1"
    local enabled policy
    config_get enabled "$section" enabled "0"
    config_get policy "$section" policy "allow"
    [ "$enabled" != "1" ] && return
    [ "$policy" != "block" ] && return
    _cur_profile="$section"
    config_list_foreach "$section" device gen_device_block_rule
}

gen_device_block_rule() {
    echo "        ether saddr ${1} counter drop comment \"familywarden:${_cur_profile}:block\""
}

# ---- Input chain generators (block_router feature) ----
#
# Mirror the forward-chain rules but scoped to the `input` hook and TCP only.
# Drops all incoming TCP from a profile's MACs to the router itself (LuCI, SSH,
# any TCP service) when the profile is in an effective blocked state and
# block_router='1'. ICMP/UDP/ARP are left alone so the device still gets a
# DHCP lease, gateway ARP, and DNS resolution.
#
# Rule order inside the chain mirrors familywarden_forward (ticket > override
# > block > scheduled) so an active allow-override / ticket always wins over
# a block/scheduled drop.

# Permanent allow overrides (timed allows / tickets are handled by the
# familywarden_ticket set at the top of the chain — see generate_include).
gen_input_override_rules() {
    local section="$1"
    local enabled override override_expires

    config_get enabled "$section" enabled "0"
    [ "$enabled" != "1" ] && return

    override=$(state_get "${section}.override" "none")
    [ "$override" = "allow" ] || return
    _is_captain_bound "$section" && return

    override_expires=$(state_get "${section}.override_expires" "")
    [ -n "$override_expires" ] && return  # ticket → handled by set

    _cur_profile="$section"
    config_list_foreach "$section" device gen_input_device_override_rule
}

gen_input_device_override_rule() {
    echo "        ether saddr ${1} tcp dport 0-65535 counter accept comment \"familywarden:${_cur_profile}:override:allow:input\""
}

# Block-policy profiles with block_router='1' that are currently effective-blocked.
gen_input_profile_block() {
    local section="$1"
    local enabled policy block_router
    config_get enabled "$section" enabled "0"
    [ "$enabled" != "1" ] && return
    config_get policy "$section" policy "allow"
    [ "$policy" = "block" ] || return
    config_get block_router "$section" block_router "0"
    [ "$block_router" = "1" ] || return
    _cur_profile="$section"
    config_list_foreach "$section" device gen_input_device_block_rule
}

gen_input_device_block_rule() {
    echo "        ether saddr ${1} tcp dport != ${FW_SAIL_PORT} counter drop comment \"familywarden:${_cur_profile}:block:input\""
}

# Scheduled profiles with block_router='1' may reach the router (TCP) only
# inside their allow windows. Same model as the forward chain: one accept per
# window (kernel-evaluated meta hour/day, shared generator _sched_accept_rules),
# then a trailing drop. Windows OR together, so several windows on one day work,
# and days without any window are blocked. Override accepts and the ticket set
# sit earlier in the chain and win over the drop.
gen_input_profile_scheduled() {
    local section="$1"
    local enabled policy block_router

    config_get enabled "$section" enabled "0"
    [ "$enabled" != "1" ] && return
    config_get policy "$section" policy "allow"
    [ "$policy" = "scheduled" ] || return
    config_get block_router "$section" block_router "0"
    [ "$block_router" = "1" ] || return

    _cur_profile="$section"
    _sched_devices=""
    config_list_foreach "$section" device _collect_dev
    [ -z "$_sched_devices" ] && return

    _sched_match="tcp dport 0-65535 "
    _sched_tag=":input"
    config_foreach _sched_accept_rules schedule
    _sched_match=""
    _sched_tag=""

    local mac
    for mac in $_sched_devices; do
        echo "        ether saddr ${mac} tcp dport != ${FW_SAIL_PORT} counter drop comment \"familywarden:${_cur_profile}:scheduled:input\""
    done
}

# Collect nft timeout-set elements for active tickets (timed allow-overrides).
# Each emits "<mac> timeout <remaining>s"; the kernel auto-removes the element
# when it expires, so a ticket lapses with no cron/poller. The remaining time is
# derived from the absolute expiry epoch, so a reload mid-ticket preserves the
# correct countdown. Expired tickets are already cleared from state by
# gc_expired_tickets before this runs, so they never appear here.
_ticket_elements=""
gen_ticket_elements() {
    local section="$1" enabled override expires rem
    config_get enabled "$section" enabled "0"
    [ "$enabled" != "1" ] && return
    override=$(state_get "${section}.override" "none")
    [ "$override" = "allow" ] || return
    _is_captain_bound "$section" && return
    expires=$(state_get "${section}.override_expires" "")
    [ -n "$expires" ] || return                  # permanent allow → not a ticket
    rem=$(( expires - $(date +%s) ))
    [ "$rem" -gt 0 ] || return
    _cur_profile="$section"
    _ticket_rem="$rem"
    config_list_foreach "$section" device gen_ticket_elem
}

gen_ticket_elem() {
    local mac="$1"
    if [ -z "$_ticket_elements" ]; then
        _ticket_elements="${mac} timeout ${_ticket_rem}s"
    else
        _ticket_elements="${_ticket_elements}, ${mac} timeout ${_ticket_rem}s"
    fi
}

# ---- Compiler pipeline ----

generate_include() {
    mkdir -p "$(dirname "$FW_INCLUDE")"

    fw_load

    # settings.enabled='0': same chains and set, but no rules in them
    local on=0
    fw_enabled && on=1

    # Collect active tickets up front so the timeout set can be declared before
    # the chain that references it.
    _ticket_elements=""
    [ "$on" = "1" ] && config_foreach gen_ticket_elements profile

    # Write fw4-include format. fw4 wraps the include in `table inet fw4 { ... }`
    # context, so we emit only table-level objects (a set + a chain, no outer
    # table).
    #
    # familywarden_ticket is a timeout set: tickets are added with a per-element
    # timeout so the KERNEL expires them on its own (no cron — schedules and
    # tickets are both kernel-evaluated). It is referenced first in the chain so
    # an active ticket wins over schedule/block drops, just like a manual allow.
    #
    # familywarden_forward is a base chain hooked on forward at priority 1
    # (just after fw4's own forward filter). policy accept means only explicit
    # matches drop. A hooked chain needs no jump and is rebuilt idempotently by
    # fw4 reload, so no flush and no duplicate rules.
    {
        echo "# /var/etc/familywarden.include"
        echo "# Generated by familywarden — do not edit"
        echo ""
        echo "set familywarden_ticket {"
        echo "    type ether_addr"
        echo "    flags timeout"
        [ -n "$_ticket_elements" ] && echo "    elements = { $_ticket_elements }"
        echo "}"
        echo ""
        # familywarden_input is a base chain hooked on input at priority 1. It
        # drops incoming TCP from blocked profiles with block_router='1' so a
        # blocked device cannot reach the router itself (LuCI, SSH, etc.). The
        # ticket accept rule at the top means an active ticket restores router
        # access for the ticket duration. ICMP/UDP/ARP are intentionally not
        # matched so the device still gets a DHCP lease and DNS.
        echo "chain familywarden_input {"
        echo "    type filter hook input priority 1; policy accept;"
        echo "        ether saddr @familywarden_ticket tcp dport 0-65535 counter accept comment \"familywarden:ticket:input\""

        if [ "$on" = "1" ]; then
            # Permanent allow overrides restore router access
            config_foreach gen_input_override_rules profile

            # Block-policy profiles with block_router='1'
            config_foreach gen_input_profile_block profile

            # Scheduled profiles currently outside an allow window, with block_router='1'
            config_foreach gen_input_profile_scheduled profile
        fi

        echo "}"
        echo ""
        # familywarden_lockdown: Ulysses. A separate base chain (input, priority
        # 2) so its accepts can't short-circuit familywarden_input's drops.
        echo "chain familywarden_lockdown {"
        echo "    type filter hook input priority 2; policy accept;"
        gen_lockdown_rules
        echo "}"
        echo ""
        echo "chain familywarden_forward {"
        echo "    type filter hook forward priority 1; policy accept;"
        echo "        ether saddr @familywarden_ticket counter accept comment \"familywarden:ticket\""

        if [ "$on" = "1" ]; then
            # Permanent override rules (block / non-expiring allow)
            config_foreach gen_override_rules profile

            # Permanent block-policy profiles
            config_foreach gen_profile_block profile

            # Then scheduled rules
            _sched_devices=""
            config_foreach gen_profile_scheduled profile

            # Last: devices in no profile (default_policy)
            gen_default_policy_rule
        fi

        echo "}"
    } > "$FW_INCLUDE_NEW"
}

_collect_dev() {
    _sched_devices="$_sched_devices $1"
}

gen_profile_scheduled() {
    local section="$1"
    local enabled policy

    config_get enabled "$section" enabled "0"
    config_get policy "$section" policy "allow"
    [ "$enabled" != "1" ] && return
    [ "$policy" != "scheduled" ] && return

    _cur_profile="$section"
    _sched_devices=""
    config_list_foreach "$section" device _collect_dev
    [ -z "$_sched_devices" ] && return

    # Accept inside each allow-window...
    config_foreach _sched_accept_rules schedule

    # ...then default-drop the device. A scheduled profile with no windows
    # has no accepts, so the device is blocked 24/7.
    local mac
    for mac in $_sched_devices; do
        echo "        ether saddr ${mac} counter drop comment \"familywarden:${_cur_profile}:scheduled\""
    done
}

compile_and_apply() {
    (
        flock -x 200 || {
            echo '{"error":"could not acquire lock"}'
            return 1
        }

        # GC expired tickets/pacts, then resolve Ulysses locks into the
        # effective config that everything below reads
        gc_expired_tickets
        gc_pact
        ulysses_sync

        # Generate the new include file
        generate_include

        # Validate syntax before applying. The include is an fw4 fragment
        # (chain decls, no table), so wrap it in table context for nft -c.
        # Use a THROWAWAY table name (not fw4): validating inside the real
        # inet fw4 would fail if a stale familywarden_forward chain from an
        # older version is loaded with a different hook/priority ("chain
        # already exists with different declaration"), wedging reload forever.
        # fw4 reload rebuilds the real table, so an isolated parse check is
        # enough and lets a stuck router self-heal on the next reload.
        if ! nft -c -f - <<EOF 2>/tmp/fw_validation_err
table inet fw_familywarden_validate {
    include "$FW_INCLUDE_NEW"
}
EOF
        then
            logger -t familywarden "ERROR: include validation failed: $(cat /tmp/fw_validation_err)"
            rm -f "$FW_INCLUDE_NEW" /tmp/fw_validation_err
            echo '{"error":"include validation failed"}'
            return 1
        fi
        rm -f /tmp/fw_validation_err

        # Atomic swap
        mv "$FW_INCLUDE_NEW" "$FW_INCLUDE"

        # Drop any pre-existing chain so fw4 recreates it cleanly from the
        # include. Without this, fw4 reload errors ("chain already exists with
        # different declaration") whenever an older version left the chain at a
        # different hook/priority — which silently drops our include and wedges
        # the firewall. Deleting first makes every reload self-healing.
        # The sub-second fail-open window before fw4 reload is acceptable.
        nft delete chain inet fw4 familywarden_forward 2>/dev/null
        nft delete chain inet fw4 familywarden_input 2>/dev/null
        nft delete chain inet fw4 familywarden_lockdown 2>/dev/null
        # Same for the ticket set (now unreferenced after the chain is gone), so
        # fw4 recreates it from the include with the current remaining timeouts.
        nft delete set inet fw4 familywarden_ticket 2>/dev/null

        # Apply via fw4 reload. fw4 flushes and rebuilds the whole inet fw4
        # table, so rules are idempotent and survive reboot.
        fw4 reload 2>/dev/null

        echo '{"status":"ok"}'
    ) 200>"$FW_LOCK"
}

# ---- Ubus handlers ----

ubus_list() {
    (
        flock -s 200 || return 1
        json_init
        json_add_object "profiles"
        fw_load
        config_foreach ubus_list_profile profile
        json_close_object
        json_dump
    ) 200>"$FW_LOCK"
}

ubus_list_profile() {
    local profile="$1"
    local name enabled policy override override_expires block_router

    config_get name "$profile" name "$profile"
    config_get enabled "$profile" enabled "0"
    [ "$enabled" != "1" ] && return

    config_get policy "$profile" policy "allow"
    config_get block_router "$profile" block_router "0"
    # Apply ticket expiry at read time so an elapsed ticket reads as "none"
    # immediately, independent of the kernel's set-element expiry.
    read -r override override_expires <<EOF
$(effective_override "$profile")
EOF
    [ -z "$override" ] && override="none"

    # Compute effective status from override + policy (+ schedule windows)
    local status
    status=$(profile_effective_status "$profile" "$policy" "$override")

    json_add_object "$profile"
    json_add_string "name" "$name"
    json_add_string "policy" "$policy"
    json_add_string "status" "$status"
    json_add_string "override" "$override"
    json_add_int "override_expires" "${override_expires:-0}"
    json_add_boolean "block_router" "$block_router"
    json_add_bound "$profile"

    json_add_array "devices"
    config_list_foreach "$profile" device json_add_dev
    json_close_array

    # Add schedules for this profile
    json_add_array "schedules"
    config_foreach ubus_list_schedule schedule "$profile"
    json_close_array

    json_close_object
}

json_add_dev() {
    json_add_string "" "$1"
}

# Ulysses fields: captain (bound by an active pact), and for the captain the
# pact details. pact_until is 0 for an ongoing pact; release_at is 0 unless
# sailing home was requested on the sail page.
json_add_bound() {
    local captain=0
    _is_captain_bound "$1" && captain=1
    json_add_boolean "captain" "$captain"
    if [ "$captain" = "1" ]; then
        local in_window=0
        pact_in_window && in_window=1
        json_add_string "pact_type" "$(pact_get type)"
        json_add_int "pact_until" "$(pact_get until)"
        json_add_string "pact_window" "$(pact_get window_day) $(pact_get window_start)-$(pact_get window_stop)"
        json_add_boolean "pact_in_window" "$in_window"
        json_add_int "release_at" "$(release_at)"
        json_add_int "mast_last_sync" "$(mast_last_sync)"
    fi
}

ubus_list_schedule() {
    local section="$1"
    local wanted_profile="$2"
    local days start stop

    local sched_profile
    config_get sched_profile "$section" profile ""
    [ "$sched_profile" != "$wanted_profile" ] && return

    config_get days "$section" days ""
    config_get start "$section" start ""
    config_get stop "$section" stop ""

    json_add_object
    json_add_string "days" "$days"
    json_add_string "start" "$start"
    json_add_string "stop" "$stop"
    json_close_object
}

ubus_status() {
    local profile="$1"

    (
        flock -s 200 || return 1

        fw_load
        local name enabled policy block_router
        config_get name "$profile" name ""
        config_get enabled "$profile" enabled "0"
        config_get policy "$profile" policy "allow"
        config_get block_router "$profile" block_router "0"

        if [ -z "$name" ] || [ "$enabled" != "1" ]; then
            echo '{"error":"profile not found or disabled"}'
            return 1
        fi

        local override override_expires
        override=$(state_get "${profile}.override" "none")
        override_expires=$(state_get "${profile}.override_expires" "")

        json_init
        json_add_string "name" "$name"
        json_add_string "policy" "$policy"
        json_add_string "status" "$(profile_effective_status "$profile" "$policy" "$override")"
        json_add_string "override" "$override"
        json_add_int "override_expires" "${override_expires:-0}"
        json_add_boolean "block_router" "$block_router"
        json_add_bound "$profile"

        json_add_array "devices"
        config_list_foreach "$profile" device json_add_dev
        json_close_array
        json_dump
    ) 200>"$FW_LOCK"
}

ubus_block() {
    local profile="$1"

    fw_load
    local name
    config_get name "$profile" name ""
    [ -z "$name" ] && { echo '{"error":"profile not found"}'; return 1; }

    state_set "${profile}.override" "block"
    state_set "${profile}.override_expires" ""
    # compile_and_apply prints the single JSON reply (status or error)
    compile_and_apply
}

ubus_allow() {
    local profile="$1"

    fw_load
    local name
    config_get name "$profile" name ""
    [ -z "$name" ] && { echo '{"error":"profile not found"}'; return 1; }
    _refuse_if_bound "$profile" && return 1

    state_set "${profile}.override" "allow"
    state_set "${profile}.override_expires" ""
    # compile_and_apply prints the single JSON reply (status or error)
    compile_and_apply
}

ubus_reset() {
    local profile="$1"

    fw_load
    local name
    config_get name "$profile" name ""
    [ -z "$name" ] && { echo '{"error":"profile not found"}'; return 1; }

    state_set "${profile}.override" "none"
    state_set "${profile}.override_expires" ""
    # compile_and_apply prints the single JSON reply (status or error)
    compile_and_apply
}

ubus_ticket() {
    (
    # Serialize ticket read/modify/apply so simultaneous additions cannot be lost.
    # Separate from FW_LOCK: compile_and_apply acquires that lock itself.
    flock -x 201 || { echo '{"error":"ticket lock failed"}'; return 1; }
    local profile="$1"
    local minutes="${2:-30}"
    case "$minutes" in
        *[!0-9]*|'') echo '{"error":"minutes must be a positive integer"}'; return 1 ;;
    esac
    # Normalize leading zeros before shell arithmetic; the ubus type is int32.
    minutes=$(echo "$minutes" | sed 's/^0*//')
    if ! [ "${minutes:-0}" -gt 0 ] 2>/dev/null || ! [ "$minutes" -le 2147483647 ] 2>/dev/null; then
        echo '{"error":"minutes must be a positive integer"}'
        return 1
    fi

    fw_load
    local name
    config_get name "$profile" name ""
    [ -z "$name" ] && { echo '{"error":"profile not found"}'; return 1; }
    _refuse_if_bound "$profile" && return 1

    local expires_epoch expires_iso now base override previous_expiry
    now=$(date +%s)
    base="$now"
    override=$(state_get "${profile}.override" "none")
    previous_expiry=$(state_get "${profile}.override_expires" "")
    if [ "$override" = "allow" ] && [ -n "$previous_expiry" ] && [ "$previous_expiry" -gt "$now" ]; then
        base="$previous_expiry"
    fi
    expires_epoch=$((base + minutes * 60))
    expires_iso=$(date -d "@${expires_epoch}" -Iseconds 2>/dev/null || date -u -d "@${expires_epoch}" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "${expires_epoch}")

    state_set "${profile}.override" "allow"
    state_set "${profile}.override_expires" "${expires_epoch}"
    # Silence compile_and_apply's own {"status":"ok"} so the reply is one JSON object
    if ! compile_and_apply >/dev/null; then
        echo '{"error":"compile failed"}'
        return 1
    fi
    echo "{\"status\":\"ok\",\"profile\":\"${profile}\",\"expires\":\"${expires_iso}\"}"
    ) 201>"${FW_LOCK}.ticket"
}

# Make (or amend) the captain's pact. until=<epoch> for a pact that ends,
# until=0 for an ongoing pact with a weekly amendment window. An "until" pact
# can only be extended; an ongoing pact can only be changed inside its window.
ubus_pact() {
    local until="${1:-0}" wday="${2:-sun}" wstart="${3:-10:00}" wstop="${4:-11:00}"
    local captain type now delay name default_policy
    now=$(date +%s)

    case "$until" in *[!0-9]*) echo '{"error":"until must be an epoch (0 = ongoing)"}'; return 1 ;; esac
    if [ "$until" = "0" ]; then
        type="ongoing"
        [ -n "$(day_to_num "$wday")" ] || { echo '{"error":"window_day must be mon..sun"}'; return 1; }
        case "$wstart$wstop" in [0-2][0-9]:[0-5][0-9][0-2][0-9]:[0-5][0-9]) ;; *) echo '{"error":"window times must be HH:MM"}'; return 1 ;; esac
        [ "$(time_to_minutes "$wstart")" -lt "$(time_to_minutes "$wstop")" ] || { echo '{"error":"window must start before it stops"}'; return 1; }
    else
        type="until"
        [ "$until" -gt $(( now + 60 )) ] || { echo '{"error":"until must be in the future"}'; return 1; }
    fi

    if pact_active; then
        captain=$(pact_get captain)
        delay=$(pact_get delay)
        default_policy=$(pact_get default_policy)
        if [ "$(pact_get type)" = "until" ] && [ "$type" = "until" ] && [ "$until" -gt "$(pact_get until)" ]; then
            :   # extending is always fine
        elif pact_in_window; then
            :   # the weekly window is for renegotiating
        else
            json_init
            json_add_string "error" "the pact can only be extended"
            json_add_string "type" "$(pact_get type)"
            json_add_int "pact_until" "$(pact_get until)"
            json_dump
            return 1
        fi
    else
        config_load familywarden
        config_get captain settings ulysses_profile ""
        config_get delay settings ulysses_delay "24"
        config_get default_policy settings default_policy "allow"
        [ -n "$captain" ] || { echo '{"error":"no Ulysses profile chosen in settings"}'; return 1; }
        config_get name "$captain" name ""
        [ -n "$name" ] || { echo '{"error":"Ulysses profile not found"}'; return 1; }
        case "$delay" in ''|*[!0-9]*) delay=24 ;; esac
        delay=$(( delay * 3600 ))
        mkdir -p "$FW_PERSIST"
        chmod 700 "$FW_PERSIST"
        profile_fragment "$captain" > "$FW_PACT_SNAP"
        pact_dns_snapshot "$captain"
    fi

    {
        echo "captain=$captain"
        echo "type=$type"
        echo "until=$until"
        echo "window_day=$wday"
        echo "window_start=$wstart"
        echo "window_stop=$wstop"
        echo "delay=$delay"
        echo "default_policy=$default_policy"
    } > "$FW_PACT.new"
    mv "$FW_PACT.new" "$FW_PACT"
    _clear_allow "$captain"
    if [ "$type" = "until" ]; then
        logger -t familywarden "Ulysses: $captain bound to the mast until $(date -d "@$until" 2>/dev/null || echo "$until")"
    else
        logger -t familywarden "Ulysses: $captain bound to the mast (ongoing, window $wday $wstart-$wstop)"
    fi

    compile_and_apply >/dev/null || { echo '{"error":"compile failed"}'; return 1; }
    json_init
    json_add_string "status" "ok"
    json_add_string "captain" "$captain"
    json_add_string "type" "$type"
    json_add_int "pact_until" "$until"
    json_dump
}

# ---- Ulysses Mast (phone app) ----
#
# The phone polls http://<router>:7700/cgi-bin/mast. The reply is two parts:
# line 1 = usign signature (base64), rest = the payload JSON, byte for byte.
# The app evaluates the captain's rules itself, so it keeps working from its
# cache when it can't reach the router (e.g. at work).

mast_keys() {
    [ -s "$FW_MAST_KEY" ] && [ -s "$FW_MAST_PUB" ] && return 0
    mkdir -p "$FW_PERSIST"
    chmod 700 "$FW_PERSIST"
    usign -G -s "$FW_MAST_KEY" -p "$FW_MAST_PUB" -c "familywarden ulysses mast" >/dev/null 2>&1
}

# Public key (base64 line of the usign .pub) and its fingerprint
mast_pubkey() {
    mast_keys
    sed -n 2p "$FW_MAST_PUB"
}

mast_fingerprint() {
    mast_keys
    usign -F -p "$FW_MAST_PUB" 2>/dev/null
}

_mast_window() {
    local s="$1" sp days start stop
    config_get sp "$s" profile ""
    [ "$sp" = "$_mast_captain" ] || return
    config_get days "$s" days ""
    config_get start "$s" start ""
    config_get stop "$s" stop ""
    [ -n "$days" ] && [ -n "$start" ] && [ -n "$stop" ] || return
    json_add_object
    json_add_string "days" "$days"
    json_add_string "start" "$start"
    json_add_string "stop" "$stop"
    json_close_object
}

# What the phone needs: is there a pact, and the captain's enforced rules
# (from the effective config, i.e. the frozen snapshot during a pact)
mast_payload() {
    local captain
    fw_load
    captain=$(_mast_captain_now)
    json_init
    json_add_int "v" 1
    json_add_int "server_time" "$(date +%s)"
    json_add_string "captain" "$captain"
    _json_pact_rules "$captain"
    json_dump
}

# The captain right now: bound by a pact, else the configured one. Needs fw_load.
_mast_captain_now() {
    local captain
    if pact_active; then
        pact_get captain
    else
        config_get captain settings ulysses_profile ""
        echo "$captain"
    fi
}

# Add the "pact" and "rules" objects for a captain ("" = none: an inactive
# pact and empty rules). Needs fw_load and an open json_init.
_json_pact_rules() {
    local captain="$1" active=0 enabled policy
    [ -n "$captain" ] && pact_active && active=1
    json_add_object "pact"
    json_add_boolean "active" "$active"
    if [ "$active" = "1" ]; then
        json_add_string "type" "$(pact_get type)"
        json_add_int "until" "$(pact_get until)"
        json_add_int "release_at" "$(release_at)"
    else
        json_add_string "type" ""
        json_add_int "until" 0
        json_add_int "release_at" 0
    fi
    json_close_object
    json_add_object "rules"
    if [ -z "$captain" ]; then
        # Nothing to enforce (no captain, or a phone outside the captain's profile)
        json_add_string "enabled" "0"
        json_add_string "policy" "allow"
        json_add_string "override" "none"
        json_add_array "windows"
        json_close_array
    else
        config_get enabled "$captain" enabled "0"
        config_get policy "$captain" policy "allow"
        json_add_string "enabled" "$enabled"
        json_add_string "policy" "$policy"
        json_add_string "override" "$(state_get "${captain}.override" none)"
        json_add_array "windows"
        _mast_captain="$captain"
        config_foreach _mast_window schedule
        json_close_array
    fi
    json_close_object
}

# Signed reply for the CGI. $1 = device id (recorded for LuCI's "last sync").
cli_mast() {
    local dev="$1" tmp
    mast_keys || { echo "error: no usign key" >&2; return 1; }
    tmp=$(mktemp)
    mast_payload | tr -d '\n' > "$tmp"
    usign -S -m "$tmp" -s "$FW_MAST_KEY" -x "$tmp.sig" || { rm -f "$tmp" "$tmp.sig"; return 1; }
    sed -n 2p "$tmp.sig"
    cat "$tmp"
    rm -f "$tmp" "$tmp.sig"
    case "$dev" in
        ''|*[!A-Za-z0-9-]*) ;;
        *) echo "$dev $(date +%s)" > "$FW_MAST_SEEN" ;;
    esac
}

mast_last_sync() {
    local dev seen=0
    [ -f "$FW_MAST_SEEN" ] && read -r dev seen < "$FW_MAST_SEEN"
    echo "${seen:-0}"
}

# Discover a numeric LAN control endpoint without depending on DNS. Do not change UCI.
mast_lan_address() {
    local address
    address=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
    [ -n "$address" ] || address=$(uci -q get network.lan.ipaddr | awk '{print $1}' | cut -d/ -f1)
    printf '%s\n' "$address" | awk -F. '
        NF == 4 {
            for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit
            if ($1 == 0 || $1 == 127 || $1 >= 224) exit
            print
        }'
}

# Keep the browser hostname for display/backward compatibility, but include a numeric
# address for new apps: a filtered resolver may not know names such as router.lan.
ubus_mast() {
    local host="$1" dev="" seen=0 pub uri address=""
    [ -f "$FW_MAST_SEEN" ] && read -r dev seen < "$FW_MAST_SEEN"
    pub=$(mast_pubkey)
    json_init
    json_add_string "pubkey" "$pub"
    json_add_string "fingerprint" "$(mast_fingerprint)"
    json_add_string "device" "$dev"
    json_add_int "last_sync" "${seen:-0}"
    case "$host" in
        ''|*[!A-Za-z0-9.:-]*) ;;
        *)
            uri="ulyssesmast://pair?host=${host}&key=$(echo "$pub" | sed 's/+/%2B/g; s|/|%2F|g; s/=/%3D/g')"
            case "$host" in *[A-Za-z]*) address=$(mast_lan_address) ;; esac
            if [ -n "$address" ]; then
                uri="${uri}&address=${address}"
                json_add_string "router_address" "$address"
            fi
            json_add_string "pair_uri" "$uri"
            command -v qrencode >/dev/null && json_add_string "qr_svg" "$(qrencode -t SVG -m 2 -o - "$uri")"
            ;;
    esac
    json_dump
}

# ---- FamilyWarden app (v2): enrolled phones ----
#
#   GET /cgi-bin/mast?device=<id>&nonce=<64 hex>&key=<usign pubkey>&sig=<usign sig>[&name=<model>]
#
# The phone signs "familywarden-sync-v2\n<id>\n<nonce>\n" with its own usign
# (Ed25519) key. Unknown or re-keyed phones wait in RAM ($FW_PENDING) until an
# administrator compares the key fingerprint in LuCI and approves them
# (device_approve), which writes a UCI "device" section. Only an approved
# id+key pair gets a binding and policy. The reply echoes the nonce and is
# signed with the router's Mast key, so the phone accepts it for exactly the
# request it made. A device id alone grants nothing.

_valid_device_id() {
    case "$1" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac
    [ "${#1}" -le 80 ]
}

# base64 of an exact length (usign public key = 56, signature = 100)
_valid_b64() {
    case "$1" in ''|*[!A-Za-z0-9+/=]*) return 1 ;; esac
    [ "${#1}" -eq "$2" ]
}

# UCI section name for a device id
_dev_section() {
    echo "dev_$(echo "$1" | tr '-' '_')"
}

# Full-key SHA-256 for enrollment. usign -F only reports a caller-chosen key ID,
# so it is not safe for comparing an incoming phone to the administrator's screen.
_key_fingerprint() {
    local t
    t=$(mktemp) || return 1
    printf 'untrusted comment: phone\n%s\n' "$1" > "$t"
    if usign -F -p "$t" >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    fi
    rm -f "$t"
}

# $1 key, $2 signature, $3 device id, $4 nonce [, $5 applied app revision: v3 message]
_phone_sig_ok() {
    local d rc
    d=$(mktemp -d) || return 1
    printf 'untrusted comment: phone\n%s\n' "$1" > "$d/pub"
    printf 'untrusted comment: phone\n%s\n' "$2" > "$d/sig"
    if [ $# -ge 5 ]; then
        printf 'familywarden-sync-v3\n%s\n%s\n%s\n' "$3" "$4" "$5" > "$d/msg"
    else
        printf 'familywarden-sync-v2\n%s\n%s\n' "$3" "$4" > "$d/msg"
    fi
    usign -V -q -m "$d/msg" -p "$d/pub" -x "$d/sig" 2>/dev/null
    rc=$?
    rm -rf "$d"
    return $rc
}

# Sets _dev_sec to the section of an approved device id ("" if none). Needs a
# loaded config; in the effective config a pact-frozen phone comes from the snapshot.
_find_dev() {
    _dev_sec=""
    _dev_want="$1"
    config_foreach _find_dev_cb device
}

_find_dev_cb() {
    local id
    config_get id "$1" id ""
    [ "$id" = "$_dev_want" ] && _dev_sec="$1"
}

# Device associations remain frozen for the whole pact, including amendment windows.
# Needs fw_load.
_dev_frozen() {
    local p
    config_get p "$1" profile ""
    [ -n "$p" ] && [ "$p" = "$(pact_captain)" ]
}

# Remember an unapproved phone (RAM only, at most $FW_PENDING_MAX, oldest dropped)
_pending_add() {
    local f="$FW_PENDING/$1" first
    mkdir -p "$FW_PENDING"
    chmod 700 "$FW_PENDING"
    if [ -f "$f" ]; then
        first=$(sed -n 3p "$f")
    else
        while [ "$(ls "$FW_PENDING" | wc -l)" -ge "$FW_PENDING_MAX" ]; do
            rm -f "$FW_PENDING/$(ls -tr "$FW_PENDING" | head -1)"
        done
    fi
    printf '%s\n%s\n%s\n%s\n' "$2" "$3" "${first:-$(date +%s)}" "$(date +%s)" > "$f.new"
    mv "$f.new" "$f"
}

# v2/v3 payload for one phone. $1 device id, $2 nonce, $3 approved section ("" =
# pending), $4 wire version (2, or 3 = v2 plus the "apps" policy). Needs fw_load.
mast2_payload() {
    local dev="$1" sec="$3" ver="${4:-2}" profile="" ptype="" pname admin captain is_cap=0 rem now tz
    now=$(date +%s)
    json_init
    json_add_int "v" "$ver"
    json_add_int "server_time" "$now"
    json_add_string "nonce" "$2"
    json_add_string "device" "$dev"
    if [ -n "$sec" ]; then
        config_get profile "$sec" profile ""
        [ -n "$profile" ] && config_get ptype "$profile" TYPE ""
    fi
    if [ "$ptype" != "profile" ]; then
        # Not approved yet, or its profile is gone: no binding, no policy
        json_add_string "enrollment" "pending"
        json_dump
        return
    fi
    json_add_string "enrollment" "approved"
    tz=$(uci -q get system.@system[0].zonename)
    case "$tz" in ''|*[!A-Za-z0-9_+/-]*) ;; *) json_add_string "timezone" "$tz" ;; esac
    config_get pname "$profile" name "$profile"
    config_get admin "$sec" administrator "0"
    rem=$(state_get "${sec}.remove_until" 0)
    case "$rem" in ''|*[!0-9]*) rem=0 ;; esac
    captain=$(_mast_captain_now)
    [ -n "$captain" ] && [ "$captain" = "$profile" ] && is_cap=1
    json_add_object "binding"
    json_add_string "device_id" "$dev"
    json_add_string "profile_id" "$profile"
    json_add_string "profile_name" "$pname"
    json_add_boolean "captain" "$is_cap"
    json_add_boolean "administrator" "$([ "$admin" = "1" ] && echo 1 || echo 0)"
    # Administrators may remove their own app; others only within an
    # administrator's one-hour approval (device_allow_removal). The phone still
    # refuses while an applicable pact is active.
    json_add_boolean "can_self_remove" "$({ [ "$admin" = "1" ] || [ "$rem" -gt "$now" ]; } && echo 1 || echo 0)"
    json_close_object
    # Only the captain's phones are bound by the pact
    if [ "$is_cap" = "1" ]; then
        json_add_string "captain" "$captain"
        _json_pact_rules "$captain"
    else
        json_add_string "captain" ""
        _json_pact_rules ""
    fi
    _json_dns "$profile"
    [ "$ver" = "3" ] && _json_apps "$profile"
    json_dump
}

# Signed v2/v3 reply for the CGI. Exit 2 = malformed request, 3 = bad phone signature.
# A v3 phone sends both signatures (sig over the v2 message, so an old router
# still answers v2) plus sig3 over the v3 message, which also binds the app
# policy revision it has applied ("-" = none).
cli_mast2() {
    local dev="$1" nonce="$2" key="$3" sig="$4" sig3="$6" applied="$7" ver=2 name known sec="" tmp
    name=$(printf '%s' "$5" | tr -cd 'A-Za-z0-9._-' | cut -c1-40)
    _valid_device_id "$dev" || return 2
    case "$nonce" in *[!0-9a-f]*) return 2 ;; esac
    [ "${#nonce}" -eq 64 ] || return 2
    _valid_b64 "$key" 56 && _valid_b64 "$sig" 100 || return 2
    if [ -n "$sig3" ]; then
        _valid_b64 "$sig3" 100 || return 2
        case "$applied" in -) ;; *[!0-9a-f]*|'') return 2 ;; *) [ "${#applied}" -eq 16 ] || return 2 ;; esac
        _phone_sig_ok "$key" "$sig3" "$dev" "$nonce" "$applied" || return 3
        ver=3
    fi
    _phone_sig_ok "$key" "$sig" "$dev" "$nonce" || return 3
    mast_keys || return 1
    (
        # Also serializes pending/seen writes against approval and other requests.
        flock -x 200 || return 1
        fw_load
        _find_dev "$dev"
        if [ -n "$_dev_sec" ]; then
            config_get known "$_dev_sec" pubkey ""
            [ "$known" = "$key" ] && sec="$_dev_sec"
        fi
        if [ -n "$sec" ]; then
            rm -f "$FW_PENDING/$dev"
            mkdir -p "$FW_SEEN_DIR"
            # Line 2: the app policy revision the phone says it applied (v3 only)
            printf '%s\n%s\n' "$(date +%s)" "$([ "$ver" = 3 ] && [ "$applied" != "-" ] && echo "$applied")" > "$FW_SEEN_DIR/$dev"
        else
            _pending_add "$dev" "$key" "$name"
        fi
        tmp=$(mktemp) || return 1
        mast2_payload "$dev" "$nonce" "$sec" "$ver" | tr -d '\n' > "$tmp"
        usign -S -m "$tmp" -s "$FW_MAST_KEY" -x "$tmp.sig" || { rm -f "$tmp" "$tmp.sig"; return 1; }
        sed -n 2p "$tmp.sig"
        cat "$tmp"
        rm -f "$tmp" "$tmp.sig"
    ) 200>"$FW_LOCK"
}

_json_device() {
    local s="$1" v now
    now=$(date +%s)
    json_add_object ""
    config_get v "$s" id ""
    json_add_string "id" "$v"
    json_add_string "seen" "$(sed -n 1p "$FW_SEEN_DIR/$v" 2>/dev/null | grep . || echo 0)"
    # Applied-state acknowledgement: what the phone enforces vs what it should
    json_add_string "apps_applied" "$(sed -n 2p "$FW_SEEN_DIR/$v" 2>/dev/null)"
    for v in name profile administrator; do
        config_get "_v" "$s" "$v" ""
        json_add_string "$v" "$_v"
    done
    config_get v "$s" profile ""
    json_add_string "apps_rev" "$(_apps_rev "$v")"
    config_get v "$s" pubkey ""
    json_add_string "fingerprint" "$(_key_fingerprint "$v")"
    v=$(state_get "${s}.remove_until" 0)
    case "$v" in ''|*[!0-9]*) v=0 ;; esac
    [ "$v" -gt "$now" ] || v=0
    json_add_int "remove_until" "$v"
    json_add_boolean "frozen" "$(_dev_frozen "$s" && echo 1 || echo 0)"
    json_close_object
}

# LuCI: approved phones (effective config, so a pact-frozen phone shows as
# frozen with its snapshot binding) and phones waiting for approval
ubus_devices() {
    local f id
    (
        flock -s 200 || return 1
        fw_load
        json_init
        json_add_array "devices"
        config_foreach _json_device device
        json_close_array
        json_add_array "pending"
        for f in "$FW_PENDING"/*; do
            [ -f "$f" ] || continue
            id=${f##*/}
            json_add_object ""
            json_add_string "id" "$id"
            json_add_string "fingerprint" "$(_key_fingerprint "$(sed -n 1p "$f")")"
            json_add_string "name" "$(sed -n 2p "$f")"
            json_add_int "first_seen" "$(sed -n 3p "$f")"
            json_add_int "last_seen" "$(sed -n 4p "$f")"
            json_close_object
        done
        json_close_array
        json_dump
    ) 200>"$FW_LOCK"
}

_json_error() {
    json_init
    json_add_string "error" "$1"
    json_dump
    return 1
}

# Append an approved phone to a running pact's snapshot (adding a phone to the
# captain only strengthens the pact). Needs the exclusive lock.
_snap_add_device() {
    local sec="$1" id="$2" name="$3" profile="$4" key="$5" admin="$6"
    pact_active && [ "$profile" = "$(pact_get captain)" ] && [ -s "$FW_PACT_SNAP" ] || return 0
    {
        echo "config device '$sec'"
        echo "	option id $(_q "$id")"
        [ -n "$name" ] && echo "	option name $(_q "$name")"
        echo "	option profile $(_q "$profile")"
        echo "	option pubkey $(_q "$key")"
        echo "	option administrator $(_q "$admin")"
    } >> "$FW_PACT_SNAP"
}

# Shared by approve/update: write a device section unless the phone is frozen
# by a pact. $1 id, $2 profile, $3 name, $4 administrator, $5 key ("" = keep)
_dev_write() {
    local id="$1" profile="$2" name="$3" admin="$4" key="$5" sec ptype old
    _valid_device_id "$id" || { _json_error "invalid device"; return 1; }
    case "$admin" in 0|1) ;; *) _json_error "administrator must be 0 or 1"; return 1 ;; esac
    name=$(printf '%s' "$name" | tr -d '\r\n' | cut -c1-64)
    case "$profile" in ''|*[!A-Za-z0-9_-]*) _json_error "invalid profile"; return 1 ;; esac
    [ "${#profile}" -le 64 ] || { _json_error "invalid profile"; return 1; }
    config_load familywarden
    config_get ptype "$profile" TYPE ""
    [ "$ptype" = "profile" ] || { _json_error "profile not found"; return 1; }
    (
        flock -x 200 || return 1
        fw_load
        _find_dev "$id"
        if [ -n "$_dev_sec" ] && _dev_frozen "$_dev_sec"; then
            _json_error "bound by Ulysses pact"
            return 1
        fi
        sec=$(_dev_section "$id")
        if [ -n "$key" ]; then
            if [ "$6" != "$(_key_fingerprint "$key")" ] ||
               [ "$(sed -n 1p "$FW_PENDING/$id" 2>/dev/null)" != "$key" ]; then
                _json_error "pending device changed; refresh and compare fingerprint"
                return 1
            fi
        fi
        if [ -z "$key" ]; then
            key=$(uci -q get "familywarden.$sec.pubkey")
            [ -n "$key" ] || { _json_error "device not found"; return 1; }
        fi
        # Values are arguments, never interpolated as UCI batch commands.
        uci set "familywarden.$sec=device" &&
        uci set "familywarden.$sec.id=$id" &&
        uci set "familywarden.$sec.name=$name" &&
        uci set "familywarden.$sec.profile=$profile" &&
        uci set "familywarden.$sec.pubkey=$key" &&
        uci set "familywarden.$sec.administrator=$admin" &&
        uci commit familywarden || { _json_error "saving device failed"; return 1; }
        _snap_add_device "$sec" "$id" "$name" "$profile" "$key" "$admin"
        rm -f "$FW_PENDING/$id"
        logger -t familywarden "device $id approved for profile $profile (administrator=$admin)"
    ) 200>"$FW_LOCK" || return 1
    compile_and_apply >/dev/null || { _json_error "compile failed"; return 1; }
    json_init
    json_add_string "status" "ok"
    json_dump
}

# Approve a pending phone, or replace an approved phone's key with the pending one
ubus_device_approve() {
    local id="$1" key
    _valid_device_id "$id" && [ -f "$FW_PENDING/$id" ] || { _json_error "no pending device"; return 1; }
    key=$(sed -n 1p "$FW_PENDING/$id")
    _valid_b64 "$key" 56 || { _json_error "invalid key"; return 1; }
    _dev_write "$id" "$2" "$3" "${4:-0}" "$key" "$5"
}

ubus_device_update() {
    local id="$1" profile="$2" name="$3" admin="$4" sec
    _valid_device_id "$id" || { _json_error "invalid device"; return 1; }
    sec=$(_dev_section "$id")
    [ -n "$profile" ] || profile=$(uci -q get "familywarden.$sec.profile")
    [ -n "$name" ] || name=$(uci -q get "familywarden.$sec.name")
    [ -n "$admin" ] || admin=$(uci -q get "familywarden.$sec.administrator")
    _dev_write "$id" "$profile" "$name" "${admin:-0}" ""
}

# Rejecting a pending key must never delete an approved device with the same ID.
ubus_device_reject() {
    _valid_device_id "$1" || { _json_error "invalid device"; return 1; }
    (
        flock -x 200 || return 1
        rm -f "$FW_PENDING/$1"
        json_init
        json_add_string "status" "ok"
        json_dump
    ) 200>"$FW_LOCK"
}

# Delete an approved phone (refused while pact-frozen).
ubus_device_delete() {
    local id="$1" sec
    _valid_device_id "$id" || { _json_error "invalid device"; return 1; }
    rm -f "$FW_PENDING/$id"
    sec=$(_dev_section "$id")
    (
        flock -x 200 || return 1
        fw_load
        _find_dev "$id"
        if [ -n "$_dev_sec" ] && _dev_frozen "$_dev_sec"; then
            _json_error "bound by Ulysses pact"
            return 1
        fi
        if uci -q get "familywarden.$sec" >/dev/null; then
            uci delete "familywarden.$sec"
            uci commit familywarden
            logger -t familywarden "device $id removed"
        fi
        state_set "${sec}.remove_until" ""
    ) 200>"$FW_LOCK" || return 1
    compile_and_apply >/dev/null
    json_init
    json_add_string "status" "ok"
    json_dump
}

# Let one managed phone remove FamilyWarden itself within the next hour
ubus_device_allow_removal() {
    local id="$1" until
    _valid_device_id "$id" || { _json_error "invalid device"; return 1; }
    (
        flock -x 200 || return 1
        fw_load
        _find_dev "$id"
        [ -n "$_dev_sec" ] || { _json_error "device not found"; return 1; }
        if _dev_frozen "$_dev_sec"; then
            _json_error "bound by Ulysses pact"
            return 1
        fi
        until=$(( $(date +%s) + 3600 ))
        state_set "${_dev_sec}.remove_until" "$until"
        logger -t familywarden "device $id may remove FamilyWarden until $until"
        json_init
        json_add_string "status" "ok"
        json_add_int "remove_until" "$until"
        json_dump
    ) 200>"$FW_LOCK"
}

# ---- DNS: AdGuard Home sync ----
#
# Profiles with option dns '1' get a persistent AGH client named
# "familywarden-<clientid>" whose only id is the ClientID; phones then use
# strict DNS-over-TLS to <clientid>.<settings.dns_domain>. FamilyWarden owns
# only clients with that name prefix and the ClientIDs it added itself to AGH's
# allowed_clients ($FW_AGH_OWNED). Every other client, access-list entry and
# AGH setting is read but never changed. /control/access/set replaces the whole
# list, so it is re-read just before writing and verified afterwards; an empty
# allowed list (everyone allowed) is never touched. A profile's DNS reaches the
# phone's policy only after AGH accepted its client ($FW_DNS_ACK), never from
# UCI alone. The ClientID is derived from the profile name once, stored as
# dns_client_id, and never renamed afterwards.
#
# Credentials: $FW_AGH_AUTH holds the Basic auth token, base64("user:password")
# (root only, written by dns_auth). AGH sends no auth challenge on its API, so
# the header is sent up front.

FW_AGH_PREFIX="familywarden-"

# $1 GET|POST, $2 path below /control/, $3 body file (POST). Body on stdout.
_agh() {
    if [ "$1" = "GET" ]; then
        uclient-fetch -q --no-proxy -T 10 -O - --header="Authorization: Basic $_agh_auth" "$_agh_url/control/$2"
    else
        uclient-fetch -q --no-proxy -T 10 -O - --header="Authorization: Basic $_agh_auth" \
            --header='Content-Type: application/json' --post-file="$3" "$_agh_url/control/$2"
    fi
}

# Display name -> DNS-safe ClientID base (a-z, 0-9, -; at most 40 chars)
_dns_slug() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' |
        sed 's/æ/ae/g; s/Æ/ae/g; s/ø/oe/g; s/Ø/oe/g; s/å/aa/g; s/Å/aa/g; s/ä/ae/g; s/Ä/ae/g; s/ö/oe/g; s/Ö/oe/g; s/ü/ue/g; s/Ü/ue/g; s/é/e/g; s/è/e/g' |
        sed 's/[^a-z0-9]\{1,\}/-/g; s/^-*//; s/-*$//' | cut -c1-40 | sed 's/-*$//'
}

_valid_client_id() {
    case "$1" in ''|-*|*-|*[!a-z0-9-]*) return 1 ;; esac
    [ "${#1}" -le 63 ]
}

_dns_collect_id() {
    local v
    config_get v "$1" dns_client_id ""
    [ -n "$v" ] && _dns_taken="$_dns_taken $v "
}

# A ClientID nobody uses yet: not in AGH (clients, access lists) and not
# stored for another profile. $1 profile id
_dns_new_id() {
    local name base id n=1
    config_get name "$1" name "$1"
    base=$(_dns_slug "$name")
    [ -n "$base" ] || base="profile"
    id="$base"
    while case "$_dns_taken" in *" $id "*) true ;; *) false ;; esac; do
        n=$((n + 1))
        id="$base-$n"
    done
    echo "$id"
}

_dns_prot_cb() { case "$_dns_prot" in *" $1 "*) ;; *) _dns_prot="$_dns_prot $1 " ;; esac; }
_dns_svc_cb() { case "$_dns_svc " in *" $1 "*) ;; *) _dns_svc="$_dns_svc $1" ;; esac; }

# A value from the captain's pact DNS snapshot ($1 profile, $2 key), one per
# line; empty unless $1 is the captain of an active pact. Set by cli_dns_sync.
_dns_snap() {
    [ -n "$_dns_cap" ] && [ "$1" = "$_dns_cap" ] && sed -n "s/^$2=//p" "$FW_PACT_DNS" 2>/dev/null
}

# Effective protections and services: live UCI plus, for a captain bound by a
# pact, everything in the snapshot (removals wait until the pact ends)
_dns_lists() {
    local x
    _dns_prot=""
    _dns_svc=""
    config_list_foreach "$1" dns_protection _dns_prot_cb
    config_list_foreach "$1" dns_service _dns_svc_cb
    for x in $(_dns_snap "$1" prot); do _dns_prot_cb "$x"; done
    for x in $(_dns_snap "$1" svc); do _dns_svc_cb "$x"; done
}

# Client fields for AGH (into the open json object). $1 profile, $2 ClientID
_dns_client_fields() {
    local p="$1" id="$2" s ss
    _dns_lists "$p"
    has() { case "$_dns_prot" in *" $1 "*) echo 1 ;; *) echo 0 ;; esac; }
    json_add_string "name" "$FW_AGH_PREFIX$id"
    json_add_array "ids"
    json_add_string "" "$id"
    json_close_array
    json_add_boolean "use_global_settings" 0
    json_add_boolean "filtering_enabled" "$(has filter_lists)"
    json_add_boolean "safebrowsing_enabled" "$(has safe_browsing)"
    json_add_boolean "parental_enabled" "$(has parental)"
    ss=$(has safe_search)
    json_add_object "safe_search"
    for s in enabled bing duckduckgo ecosia google pixabay yandex youtube; do
        json_add_boolean "$s" "$ss"
    done
    json_close_object
    json_add_boolean "use_global_blocked_services" 0
    json_add_array "blocked_services"
    for s in $_dns_svc; do
        case "$s" in *[!a-z0-9_]*) ;; *) json_add_string "" "$s" ;; esac
    done
    json_close_array
    json_add_array "upstreams"
    json_close_array
    json_add_array "tags"
    json_close_array
    json_add_boolean "ignore_querylog" 0
    json_add_boolean "ignore_statistics" 0
}

# Ack line for a synced profile: "<profile> <clientid> <domain> <protections> <services>"
_dns_ack_line() {
    local p s
    _dns_lists "$1"
    p=""
    for s in filter_lists safe_browsing parental safe_search; do
        case "$_dns_prot" in *" $s "*) p="$p,$s" ;; esac
    done
    p=${p#,}
    s=$(echo $_dns_svc | tr ' ' ',')
    echo "$1 $2 $3 ${p:--} ${s:--}"
}

# Is $1 a line of the newline-separated list $2?
_in_list() {
    printf '%s\n' "$2" | grep -qxF -- "$1"
}

_dns_profile_cb() {
    local p="$1" on
    config_get on "$p" dns "0"
    [ "$(_dns_snap "$p" dns)" = "1" ] && on=1
    [ "$on" = "1" ] && _dns_profiles="$_dns_profiles $p"
}

_json_dns() {
    local line x
    [ -s "$FW_DNS_ACK" ] || return 0
    line=$(awk -v p="$1" '$1 == p { print; exit }' "$FW_DNS_ACK")
    [ -n "$line" ] || return 0
    set -- $line
    json_add_object "dns"
    json_add_string "hostname" "$2.$3"
    json_add_array "protections"
    for x in $(echo "$4" | tr ',' ' '); do [ "$x" = "-" ] || json_add_string "" "$x"; done
    json_close_array
    json_add_array "services"
    for x in $(echo "$5" | tr ',' ' '); do [ "$x" = "-" ] || json_add_string "" "$x"; done
    json_close_array
    json_close_object
}

_dns_status() {
    json_init
    json_add_int "time" "$(date +%s)"
    json_add_string "error" "$1"
    json_dump > "$FW_DNS_STATUS"
    [ -z "$1" ] || logger -t familywarden "DNS sync: $1"
}

# Bring AGH in line with UCI (live config: DNS is not frozen by a pact).
# Returns 0 when everything is in sync, 1 otherwise (status in $FW_DNS_STATUS).
cli_dns_sync() {
    (
        flock -x 201 || return 1
        _dns_sync_locked
    ) 201>"$FW_DNS_LOCK"
}

_dns_sync_locked() {
    local domain url d p id ids name allowed disallowed hosts owned new_allowed new_owned
    ids=""
    local ack="" err="" changed=0 x keep="" old
    rm -f "$FW_DNS_DIRTY"
    config_load familywarden
    config_get domain settings dns_domain ""
    config_get url settings agh_url ""
    # Captain bound by a pact: its DNS and the DNS domain can only be tightened
    _dns_cap=""
    if pact_active && [ -s "$FW_PACT_DNS" ]; then
        _dns_cap=$(pact_get captain)
        x=$(sed -n 's/^domain=//p' "$FW_PACT_DNS")
        [ -n "$x" ] && domain="$x"
    fi
    _dns_profiles=""
    config_foreach _dns_profile_cb profile
    # Even if its profile section was deleted meanwhile
    if [ "$(_dns_snap "$_dns_cap" dns)" = "1" ]; then
        case " $_dns_profiles " in *" $_dns_cap "*) ;; *) _dns_profiles="$_dns_profiles $_dns_cap" ;; esac
    fi
    if [ -z "$domain" ] || [ -z "$url" ]; then
        # Clearing the settings is no way out of a pact either
        [ -n "$_dns_cap" ] || rm -f "$FW_DNS_ACK"
        [ -n "$_dns_profiles" ] && { _dns_status "DNS domain or AdGuard Home URL not set"; return 1; }
        _dns_status ""
        return 0
    fi
    case "$url" in http://*|https://*) ;; *) _dns_status "AdGuard Home URL must start with http:// or https://"; return 1 ;; esac
    _agh_url=${url%/}
    _agh_auth=$(cat "$FW_AGH_AUTH" 2>/dev/null)
    [ -n "$_agh_auth" ] || { _dns_status "AdGuard Home credentials not set"; return 1; }

    d=$(mktemp -d) || return 1
    if ! _agh GET clients > "$d/clients" || ! _agh GET access/list > "$d/access"; then
        rm -rf "$d"
        _dns_status "AdGuard Home unreachable or credentials rejected"
        return 1
    fi
    allowed=$(jsonfilter -i "$d/access" -e '@.allowed_clients[*]' 2>/dev/null)
    _dns_taken=" $(jsonfilter -i "$d/clients" -e '@.clients[*].ids[*]' 2>/dev/null | tr '\n' ' ') $(echo "$allowed" | tr '\n' ' ') $(jsonfilter -i "$d/access" -e '@.disallowed_clients[*]' 2>/dev/null | tr '\n' ' ') "
    config_foreach _dns_collect_id profile
    owned=$(cat "$FW_AGH_OWNED" 2>/dev/null)

    # 1. Our clients: add or update
    for p in $_dns_profiles; do
        config_get id "$p" dns_client_id ""
        [ -n "$id" ] || id=$(_dns_snap "$p" id)
        if [ -z "$id" ]; then
            id=$(_dns_new_id "$p")
            uci set "familywarden.$p.dns_client_id=$id"
            uci commit familywarden
            _dns_taken="$_dns_taken $id "
            logger -t familywarden "DNS: profile $p gets ClientID $id"
        fi
        _valid_client_id "$id" || { err="invalid ClientID for $p"; continue; }
        keep="$keep$id
"
        # On failure below, keep this profile's last acknowledged policy
        old=$(awk -v p="$p" '$1 == p { print; exit }' "$FW_DNS_ACK" 2>/dev/null)
        name="$FW_AGH_PREFIX$id"
        # Someone else's client already claims this id: never take it over
        if jsonfilter -i "$d/clients" -e "@.clients[@.name!='$name'].ids[*]" 2>/dev/null | grep -qx "$id"; then
            err="ClientID $id is used by another AdGuard Home client"
            [ -n "$old" ] && ack="$ack$old
"
            continue
        fi
        json_init
        if jsonfilter -i "$d/clients" -e '@.clients[*].name' 2>/dev/null | grep -qx "$name"; then
            json_add_string "name" "$name"
            json_add_object "data"
            _dns_client_fields "$p" "$id"
            json_close_object
            json_dump > "$d/body"
            _agh POST clients/update "$d/body" >/dev/null || { err="updating $name failed"; [ -n "$old" ] && ack="$ack$old
"; continue; }
        else
            _dns_client_fields "$p" "$id"
            json_dump > "$d/body"
            _agh POST clients/add "$d/body" >/dev/null || { err="adding $name failed"; [ -n "$old" ] && ack="$ack$old
"; continue; }
        fi
        ids="$ids$id
"
        ack="$ack$(_dns_ack_line "$p" "$id" "$domain")
"
    done

    # 2. Our clients that no longer belong to a DNS profile
    for name in $(jsonfilter -i "$d/clients" -e '@.clients[*].name' 2>/dev/null | grep "^$FW_AGH_PREFIX"); do
        # Still a DNS profile (even if its update failed above): keep it
        _in_list "${name#$FW_AGH_PREFIX}" "$keep" && continue
        json_init
        json_add_string "name" "$name"
        json_dump > "$d/body"
        _agh POST clients/delete "$d/body" >/dev/null || err="deleting $name failed"
    done

    # 3. allowed_clients: add our missing ids, drop ids we own that are no longer used
    if [ -n "$allowed" ]; then
        _agh GET access/list > "$d/access" || { rm -rf "$d"; _dns_status "AdGuard Home access list unreadable"; return 1; }
        allowed=$(jsonfilter -i "$d/access" -e '@.allowed_clients[*]' 2>/dev/null)
        new_allowed=""
        new_owned=""
        for x in $allowed; do
            if _in_list "$x" "$owned" && ! _in_list "$x" "$keep"; then
                changed=1
                continue
            fi
            new_allowed="$new_allowed$x
"
            _in_list "$x" "$owned" && new_owned="$new_owned$x
"
        done
        for x in $ids; do
            _in_list "$x" "$allowed" && continue
            new_allowed="$new_allowed$x
"
            new_owned="$new_owned$x
"
            changed=1
        done
        if [ "$changed" = "1" ]; then
            json_init
            json_add_array "allowed_clients"
            for x in $new_allowed; do json_add_string "" "$x"; done
            json_close_array
            json_add_array "disallowed_clients"
            jsonfilter -i "$d/access" -e '@.disallowed_clients[*]' 2>/dev/null > "$d/dis"
            while IFS= read -r x; do json_add_string "" "$x"; done < "$d/dis"
            json_close_array
            json_add_array "blocked_hosts"
            jsonfilter -i "$d/access" -e '@.blocked_hosts[*]' 2>/dev/null > "$d/hosts"
            while IFS= read -r x; do json_add_string "" "$x"; done < "$d/hosts"
            json_close_array
            json_dump > "$d/body"
            if ! _agh POST access/set "$d/body" >/dev/null; then
                rm -rf "$d"
                _dns_status "updating AdGuard Home allowed clients failed"
                return 1
            fi
            # Verify: exactly the intended list, the rest untouched
            _agh GET access/list > "$d/after" || { rm -rf "$d"; _dns_status "access list not readable after update"; return 1; }
            if [ "$(jsonfilter -i "$d/after" -e '@.allowed_clients[*]' | sort)" != "$(printf '%s' "$new_allowed" | sort)" ] ||
               [ "$(jsonfilter -i "$d/after" -e '@.disallowed_clients[*]')" != "$(cat "$d/dis")" ] ||
               [ "$(jsonfilter -i "$d/after" -e '@.blocked_hosts[*]')" != "$(cat "$d/hosts")" ]; then
                rm -rf "$d"
                _dns_status "AdGuard Home access list changed unexpectedly; check it manually"
                return 1
            fi
        fi
        printf '%s' "$new_owned" > "$FW_AGH_OWNED.new"
        mv "$FW_AGH_OWNED.new" "$FW_AGH_OWNED"
    fi
    rm -rf "$d"

    printf '%s' "$ack" > "$FW_DNS_ACK.new"
    mv "$FW_DNS_ACK.new" "$FW_DNS_ACK"
    _dns_status "$err"
    [ -z "$err" ]
}

# Called every minute by the init script: sync AGH after a config change, and
# keep retrying (at most every 5 minutes) while it fails.
cli_dns_tick() {
    local t=0 now
    now=$(date +%s)
    [ -f "$FW_DNS_STATUS" ] && t=$(jsonfilter -i "$FW_DNS_STATUS" -e '@.time' 2>/dev/null)
    if [ -f "$FW_DNS_DIRTY" ] || { [ -n "$(jsonfilter -i "$FW_DNS_STATUS" -e '@.error' 2>/dev/null)" ] && [ $((now - ${t:-0})) -ge 300 ]; }; then
        cli_dns_sync >/dev/null 2>&1
    fi
}

ubus_dns_status() {
    local domain
    config_load familywarden
    config_get domain settings dns_domain ""
    json_init
    json_add_boolean "credentials" "$([ -s "$FW_AGH_AUTH" ] && echo 1 || echo 0)"
    json_add_int "time" "$(jsonfilter -i "$FW_DNS_STATUS" -e '@.time' 2>/dev/null || echo 0)"
    json_add_string "error" "$(jsonfilter -i "$FW_DNS_STATUS" -e '@.error' 2>/dev/null)"
    json_add_boolean "pending" "$([ -f "$FW_DNS_DIRTY" ] && echo 1 || echo 0)"
    json_add_object "profiles"
    if [ -s "$FW_DNS_ACK" ]; then
        while read -r p id dom prot svc; do
            json_add_object "$p"
            json_add_string "client_id" "$id"
            json_add_string "hostname" "$id.$dom"
            json_add_string "protections" "$prot"
            json_add_string "services" "$svc"
            json_close_object
        done < "$FW_DNS_ACK"
    fi
    json_close_object
    json_dump
}

ubus_dns_sync() {
    cli_dns_sync >/dev/null 2>&1
    ubus_dns_status
}

# Write-only: LuCI never reads the password back
ubus_dns_auth() {
    case "$1$2" in *"
"*) _json_error "invalid credentials"; return 1 ;; esac
    case "$1" in ''|*:*) _json_error "invalid username"; return 1 ;; esac
    [ -n "$2" ] || { _json_error "empty password"; return 1; }
    mkdir -p "$FW_PERSIST"
    chmod 700 "$FW_PERSIST"
    ( umask 077; printf '%s:%s' "$1" "$2" | ucode -l fs -e 'print(b64enc(fs.stdin.read("all")))' > "$FW_AGH_AUTH.new" )
    [ -s "$FW_AGH_AUTH.new" ] || { rm -f "$FW_AGH_AUTH.new"; _json_error "could not encode credentials"; return 1; }
    mv "$FW_AGH_AUTH.new" "$FW_AGH_AUTH"
    touch "$FW_DNS_DIRTY"
    json_init
    json_add_string "status" "ok"
    json_dump
}

# Blockable services from AGH, for LuCI's service picker
ubus_dns_services() {
    local url d id name
    config_load familywarden
    config_get url settings agh_url ""
    _agh_url=${url%/}
    _agh_auth=$(cat "$FW_AGH_AUTH" 2>/dev/null)
    [ -n "$_agh_url" ] && [ -n "$_agh_auth" ] || { _json_error "AdGuard Home not configured"; return 1; }
    d=$(mktemp -d) || return 1
    _agh GET blocked_services/all > "$d/all" || { rm -rf "$d"; _json_error "AdGuard Home unreachable"; return 1; }
    jsonfilter -i "$d/all" -e '@.blocked_services[*].id' > "$d/ids" 2>/dev/null
    jsonfilter -i "$d/all" -e '@.blocked_services[*].name' > "$d/names" 2>/dev/null
    json_init
    json_add_array "services"
    awk 'NR == FNR { id[FNR] = $0; next } { print id[FNR] "\t" $0 }' "$d/ids" "$d/names" > "$d/pairs"
    while IFS="$(printf '\t')" read -r id name; do
        json_add_object ""
        json_add_string "id" "$id"
        json_add_string "name" "$name"
        json_close_object
    done < "$d/pairs"
    json_close_array
    rm -rf "$d"
    json_dump
}

# ---- Sail page backend (CLI only; called by the CGI on $FW_SAIL_PORT) ----

cli_sail_status() {
    local captain="" active=0
    pact_active && active=1 && captain=$(pact_get captain)
    json_init
    json_add_boolean "pact" "$active"
    json_add_string "captain" "$captain"
    json_add_string "type" "$(pact_get type)"
    json_add_int "pact_until" "$(pact_get until)"
    json_add_string "window" "$(pact_get window_day) $(pact_get window_start)-$(pact_get window_stop)"
    json_add_int "delay" "$(pact_get delay)"
    json_add_int "release_at" "$(release_at)"
    json_add_int "now" "$(date +%s)"
    json_dump
}

cli_sail_request() {
    pact_active || { echo '{"error":"there is no pact"}'; return 1; }
    if [ "$(release_at)" = "0" ]; then
        echo $(( $(date +%s) + $(pact_get delay) )) > "$FW_RELEASE"
        logger -t familywarden "Ulysses: sailing home requested, free at $(cat "$FW_RELEASE")"
    fi
    cli_sail_status
}

cli_sail_cancel() {
    rm -f "$FW_RELEASE"
    logger -t familywarden "Ulysses: sailing home cancelled"
    cli_sail_status
}

# Run every minute by the init script's procd instance: recompile when a
# requested release is due or an "until" pact has ended. A no-op otherwise.
cli_tick() {
    [ -f "$FW_PACT" ] || return 0
    local rel
    rel=$(release_at)
    if { [ "$rel" != "0" ] && [ "$(date +%s)" -ge "$rel" ]; } || ! pact_active; then
        compile_and_apply >/dev/null
    fi
}

ubus_reload() {
    # A config change may concern DNS too: the init script's tick syncs AGH
    touch "$FW_DNS_DIRTY"
    # compile_and_apply prints the single JSON reply (status or error)
    compile_and_apply
}

# Report installed versions of the familywarden plugin and the luci frontend
# app so the settings page can show "frontend X / backend Y". Both pkgs carry
# the version in their apk package metadata; `apk -v list -I` prints the
# installed copy in the form "name-VERSION".
ubus_version() {
    local backend_pkg luci_pkg
    # `apk -v list -I <pkg>` prints "name-VERSION ..." on the first line and a
    # wrapped description on following lines, so take field 1 of line 1 only.
    backend_pkg=$(apk -v list -I familywarden 2>/dev/null | awk 'NR==1{print $1}')
    luci_pkg=$(apk -v list -I luci-app-familywarden 2>/dev/null | awk 'NR==1{print $1}')
    json_init
    json_add_string "backend" "${backend_pkg:-unknown}"
    json_add_string "frontend" "${luci_pkg:-unknown}"
    json_dump
}

# ---- Main entry point ----

case "$1" in
    list)
        cat <<'EOF'
{
  "list": {},
  "status": { "profile": "string" },
  "block": { "profile": "string" },
  "allow": { "profile": "string" },
  "reset": { "profile": "string" },
  "ticket": { "profile": "string", "minutes": 0 },
  "bonus": { "profile": "string", "minutes": 0, "package": "string" },
  "pact": { "until": 0, "window_day": "string", "window_start": "string", "window_stop": "string" },
  "reload": {},
  "mast": { "host": "string" },
  "version": {},
  "devices": {},
  "device_approve": { "device": "string", "profile": "string", "name": "string", "administrator": "string", "fingerprint": "string" },
  "device_reject": { "device": "string" },
  "device_update": { "device": "string", "profile": "string", "name": "string", "administrator": "string" },
  "device_delete": { "device": "string" },
  "device_allow_removal": { "device": "string" },
  "dns_status": {},
  "dns_sync": {},
  "dns_auth": { "username": "string", "password": "string" },
  "dns_services": {}
}
EOF
        ;;
    sail-status)
        cli_sail_status
        ;;
    sail-request)
        cli_sail_request
        ;;
    sail-cancel)
        cli_sail_cancel
        ;;
    mast)
        cli_mast "$2"
        ;;
    mast2)
        # $2 device, $3 nonce, $4 phone key, $5 phone signature, $6 model name,
        # $7 v3 signature, $8 applied app policy revision (v3 only)
        cli_mast2 "$2" "$3" "$4" "$5" "$6" "$7" "$8"
        ;;
    dns-sync)
        cli_dns_sync
        ;;
    dns-tick)
        cli_dns_tick
        ;;
    mast-pubkey)
        # line 1 = public key (base64), line 2 = fingerprint
        mast_pubkey
        mast_fingerprint
        ;;
    tick)
        cli_tick
        ;;
    reload)
        # Plain CLI entrypoint used by the init script (start_service and the
        # procd reload trigger run "$BIN reload"). Without this case a bare
        # "reload" arg is a no-op, so boot and config-change triggers would
        # silently never regenerate the include.
        ubus_reload
        ;;
    call)
        case "$2" in
            list)
                ubus_list
                ;;
            status)
                read -r input
                json_load "$input"
                json_get_var profile profile
                ubus_status "$profile"
                ;;
            block)
                read -r input
                json_load "$input"
                json_get_var profile profile
                ubus_block "$profile"
                ;;
            allow)
                read -r input
                json_load "$input"
                json_get_var profile profile
                ubus_allow "$profile"
                ;;
            reset)
                read -r input
                json_load "$input"
                json_get_var profile profile
                ubus_reset "$profile"
                ;;
            ticket)
                read -r input
                json_load "$input"
                json_get_var profile profile
                json_get_var minutes minutes 30
                ubus_ticket "$profile" "$minutes"
                ;;
            bonus)
                read -r input
                json_load "$input"
                json_get_var profile profile
                json_get_var minutes minutes
                json_get_var package package
                ubus_bonus "$profile" "$minutes" "$package"
                ;;
            pact)
                read -r input
                json_load "$input"
                json_get_var until until 0
                json_get_var window_day window_day sun
                json_get_var window_start window_start 10:00
                json_get_var window_stop window_stop 11:00
                ubus_pact "$until" "$window_day" "$window_start" "$window_stop"
                ;;
            reload)
                ubus_reload
                ;;
            mast)
                read -r input
                json_load "$input"
                json_get_var host host
                ubus_mast "$host"
                ;;
            version)
                ubus_version
                ;;
            devices)
                ubus_devices
                ;;
            device_approve)
                read -r input
                json_load "$input"
                json_get_var device device
                json_get_var profile profile
                json_get_var name name
                json_get_var administrator administrator
                json_get_var fingerprint fingerprint
                ubus_device_approve "$device" "$profile" "$name" "$administrator" "$fingerprint"
                ;;
            device_update)
                read -r input
                json_load "$input"
                json_get_var device device
                json_get_var profile profile
                json_get_var name name
                json_get_var administrator administrator
                ubus_device_update "$device" "$profile" "$name" "$administrator"
                ;;
            device_reject)
                read -r input
                json_load "$input"
                json_get_var device device
                ubus_device_reject "$device"
                ;;
            device_delete)
                read -r input
                json_load "$input"
                json_get_var device device
                ubus_device_delete "$device"
                ;;
            device_allow_removal)
                read -r input
                json_load "$input"
                json_get_var device device
                ubus_device_allow_removal "$device"
                ;;
            dns_status)
                ubus_dns_status
                ;;
            dns_sync)
                ubus_dns_sync
                ;;
            dns_auth)
                read -r input
                json_load "$input"
                json_get_var username username
                json_get_var password password
                ubus_dns_auth "$username" "$password"
                ;;
            dns_services)
                ubus_dns_services
                ;;
        esac
        ;;
esac
