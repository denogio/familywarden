#!/bin/sh
# Signed uploads from FamilyWarden phones (port 7700): extra-time requests and usage
# reports from a child's phone, decisions (time and new apps) from a parent's phone,
# and bounded read-only app history for the phone's own or assigned profiles.
#
#   POST /cgi-bin/app?op=request|decision|usage|app|history   body: usign signature line + exact JSON
#
# Verification, the request ledger and grants live in the Go core
# (plans/core-migration.md); this only forwards. Core down = 503.
exec /usr/sbin/familywardend -socket /var/run/familywarden-core/core.sock cgi-app
