#!/bin/sh
# Sail page backend (uhttpd instance on port 7700, see the package postinst).
# The only way out of a Ulysses pact: root password + the line from Josh
# Garrels' "Ulysses", then the cooling-off frozen into the pact must pass.
#
#   GET                                   -> pact status
#   POST {"action":"release","password":..,"answer":..}
#   POST {"action":"cancel","password":..}

. /usr/share/libubox/jshn.sh

BIN=/usr/libexec/rpcd/familywarden

reply() {
    echo "Content-Type: application/json"
    echo "Cache-Control: no-store"
    echo ""
    echo "$1"
}

error() {
    json_init
    json_add_string "error" "$1"
    reply "$(json_dump)"
    exit 0
}

# Valid root password? Asks rpcd for a session and throws it away again.
check_password() {
    local req sid
    json_init
    json_add_string "username" "root"
    json_add_string "password" "$1"
    req=$(json_dump)
    sid=$(ubus call session login "$req" 2>/dev/null | jsonfilter -e '@.ubus_rpc_session' 2>/dev/null)
    [ -n "$sid" ] || return 1
    ubus call session destroy "{\"ubus_rpc_session\":\"$sid\"}" >/dev/null 2>&1
    return 0
}

if [ "$REQUEST_METHOD" != "POST" ]; then
    reply "$("$BIN" sail-status)"
    exit 0
fi

case "${CONTENT_LENGTH:-0}" in *[!0-9]*|'') error "bad request";; esac
[ "${CONTENT_LENGTH:-0}" -le 8192 ] || error "bad request"
body=$(head -c "${CONTENT_LENGTH:-0}")
json_load "$body" 2>/dev/null || error "bad request"
json_get_var action action
json_get_var password password
json_get_var answer answer

# One attempt at a time, and a slow reply to a wrong password, so the LAN
# can't brute-force the root password through this page
exec 9>/var/lock/familywarden-sail.lock
flock 9
if ! check_password "$password"; then
    sleep 3
    error "wrong password"
fi

# Root authentication/throttling remain native; owned product decisions use
# the core's dedicated protected-release route, never the administrator API.
if [ -e /etc/familywarden/core/configuration.json ] || [ -L /etc/familywarden/core/configuration.json ] ||
   [ -e /etc/familywarden/core/authority.json ] || [ -L /etc/familywarden/core/authority.json ]; then
    case "$action" in release) op=request;; cancel) op=cancel;; *) error "unknown action";; esac
    json_init
    [ "$op" != request ] || json_add_string answer "$answer"
    reply "$(json_dump | /usr/sbin/familywardend release "$op")"
    exit 0
fi

case "$action" in
    release)
        answer=$(echo "$answer" | tr 'A-Z' 'a-z' | sed 's/[^a-z ]//g; s/^ *//; s/ *$//')
        [ "$answer" = "press on" ] || error "The sirens sing on. Still tied to the mast."
        reply "$("$BIN" sail-request)"
        ;;
    cancel)
        reply "$("$BIN" sail-cancel)"
        ;;
    *)
        error "unknown action"
        ;;
esac
