<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App bar -->
    <string name="mast_title">Ulysses Mast</string>

    <!-- Actions -->
    <string name="action_sync">Sync now</string>
    <string name="action_syncing">Syncing…</string>
    <string name="action_try_again">Try again</string>
    <string name="action_check_again">Check again</string>
    <string name="action_scan">Scan pairing code</string>
    <string name="action_pair_manually">Enter address manually</string>
    <string name="action_pair_other">Pair with another router</string>
    <string name="action_pair_confirm">It matches, pair</string>
    <string name="action_remove">Remove FamilyWarden</string>
    <string name="action_remove_confirm">Remove</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_continue">Continue</string>
    <string name="action_ok">OK</string>
    <string name="action_copy_command">Copy command</string>
    <string name="copied">Copied</string>

    <!-- 1. Not device owner -->
    <string name="setup_title">One step before setting sail</string>
    <string name="setup_body">To lock strict DNS settings and manage tethering, FamilyWarden must be this phone\'s Device Owner. Setup needs Android provisioning, usually via adb on a phone without accounts or extra profiles. Back up important data first.</string>
    <string name="setup_overline">Set up once</string>
    <string name="setup_step_1">Turn on USB debugging in Developer options.</string>
    <string name="setup_step_2">Read the setup guide before removing accounts or profiles. Unsynced and profile-local data may be lost.</string>
    <string name="setup_step_3">Connect the phone and run:</string>
    <string name="setup_command" translatable="false">adb shell dpm set-device-owner io.github.denogio.familywarden/.AdminReceiver</string>

    <!-- 2. Not paired -->
    <string name="pair_title">Pair with your router</string>
    <string name="pair_body">Open FamilyWarden\'s pairing code on your router and scan it with this phone. A compatible router must confirm this phone\'s profile before protection can be applied.</string>
    <string name="pair_path_familywarden" translatable="false">FamilyWarden</string>
    <string name="pair_path_settings">Settings</string>
    <string name="pair_path_ulysses" translatable="false">Ulysses</string>
    <string name="pair_path_description">FamilyWarden, then Settings, then Ulysses</string>
    <string name="pair_unpaired_status">Hotspot is allowed. Nothing is enforced until you pair.</string>

    <!-- Manual pairing -->
    <string name="pair_manual_title">Router address</string>
    <string name="pair_manual_body">Enter the router\'s numeric LAN address, normally with port 7700. A numeric address keeps router sync independent of filtered DNS.</string>
    <string name="pair_manual_label">Address and port</string>
    <string name="pair_manual_placeholder" translatable="false">192.168.1.1:7700</string>

    <!-- 3. Pairing confirmation -->
    <string name="pair_confirm_title">Confirm the router</string>
    <string name="pair_confirm_address">Router address</string>
    <string name="pair_confirm_fingerprint">Key fingerprint</string>
    <string name="pair_confirm_hint">Check that it matches the fingerprint in LuCI under FamilyWarden › Settings › Ulysses. If it differs, do not pair.</string>

    <!-- 4-7. Status -->
    <string name="status_no_captain_title">No captain aboard</string>
    <string name="status_allowed_title">Hotspot is allowed</string>
    <!-- %1$s = "today at 21:30", %2$s = "3 h 12 min" -->
    <string name="status_locked_title">Hotspot is locked</string>
    <!-- %1$s = "tomorrow at 06:00" -->
    <!-- %1$s = "8 h 24 min" -->
    <string name="status_sailing_home_overline">Sailing home</string>
    <!-- %1$s = "today at 22:15" -->

    <!-- Pact card -->
    <string name="pact_ongoing">Bound by an ongoing pact</string>
    <!-- %1$s = "Tue 3 Nov" -->
    <string name="pact_until">Bound until %1$s</string>
    <!-- %2$s = "06:00–21:30, every day" -->
    <string name="pact_release_requested">Release requested.</string>
    <string name="pact_locked_note">While this pact is active, Ulysses cannot be disabled, re-paired, or removed.</string>

    <!-- 9. Remove -->
    <string name="remove_refused_title">The pact still holds</string>
    <string name="remove_refused_body">Mast cannot confirm that the pact for %1$s has ended. The router may be unreachable or still report an active pact. Try syncing again.</string>
    <string name="remove_refused_body_no_captain">Mast cannot confirm that no pact is active. The router may be unreachable or still report an active pact. Try syncing again.</string>
    <string name="remove_confirm_title">Remove FamilyWarden?</string>
    <string name="remove_confirm_body">Removing gives up device owner rights, so hotspot can no longer be locked. If paired, Mast checks with the router again before removing. Binding yourself again later needs the adb setup once more.</string>

    <!-- Details -->
    <string name="details_title">Details</string>
    <string name="details_captain">Captain</string>
    <string name="details_router">Router</string>
    <string name="details_key">Key</string>
