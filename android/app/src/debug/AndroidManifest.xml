<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug-only P2 probes: usage access is granted by adb (appops), never requested from users here -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <queries>
        <package android:name="io.github.denogio.familywarden.fixture" />
    </queries>
    <application>
        <activity android:name=".LockTaskProbeActivity" android:exported="false" />
        <!-- Reversible emulator-only Home/bootstrap research; never part of release. -->
        <activity android:name=".LockTaskHomeProbe" android:exported="true"
            android:directBootAware="true" android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".LockTaskBootProbe" android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Entry points require Device Owner, an eligible systemExempted use case.
             Lint only models the alternative alarm-permission eligibility path. -->
        <service android:name=".AppControlProbe" android:exported="false"
            android:foregroundServiceType="systemExempted" tools:ignore="ForegroundServicePermission" />
        <service android:name=".PackageWatchProbe" android:exported="false"
            android:foregroundServiceType="systemExempted" tools:ignore="ForegroundServicePermission" />
        <!-- Debug builds only: lets scripts/test-mast-emulator.sh pair and sync via adb -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.denogio.familywarden.DEBUG_PAIR" />
                <action android:name="io.github.denogio.familywarden.DEBUG_SYNC" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: P2 capability experiments (app suspension, usage events) -->
        <receiver
            android:name=".DebugProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.denogio.familywarden.PROBE_SUSPEND" />
                <action android:name="io.github.denogio.familywarden.PROBE_UNINSTALL_BLOCK" />
                <action android:name="io.github.denogio.familywarden.PROBE_USAGE" />
                <action android:name="io.github.denogio.familywarden.PROBE_AUTOSUSPEND" />
                <action android:name="io.github.denogio.familywarden.PROBE_HIDE" />
                <action android:name="io.github.denogio.familywarden.PROBE_RESTRICT" />
                <action android:name="io.github.denogio.familywarden.PROBE_SUPPORT" />
                <action android:name="io.github.denogio.familywarden.PROBE_PLAY" />
                <action android:name="io.github.denogio.familywarden.PROBE_PACKAGE_WATCH" />
                <action android:name="io.github.denogio.familywarden.PROBE_APP_CONTROL" />
                <action android:name="io.github.denogio.familywarden.PROBE_LOCK_TASK" />
                <action android:name="io.github.denogio.familywarden.PROBE_LOCK_TASK_IN_TASK" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
