#!/bin/sh /etc/rc.common

# familywarden-core procd init script. Independent of the familywarden service:
# the firewall never waits for, or depends on, the core.

USE_PROCD=1
START=94
STOP=02

DATA=/etc/familywarden/core
RUN=/var/run/familywarden-core

start_service() {
    # Own directory, root-only: the shell package's /var/run/familywarden is not shared.
    mkdir -p "$RUN" && chmod 700 "$RUN"
    procd_open_instance
    procd_set_param command /usr/sbin/familywardend -data "$DATA" -socket "$RUN/core.sock"
    # Back off after repeated crashes instead of looping on a broken data directory.
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
