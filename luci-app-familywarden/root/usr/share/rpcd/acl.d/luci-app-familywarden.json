{
	"luci-app-familywarden": {
		"description": "Grant access to FamilyWarden parental control",
		"read": {
			"ubus": {
				"familywarden": [ "list", "status", "traffic", "mast", "version", "devices", "requests", "usage", "new_apps", "dns_status", "dns_services" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints" ]
			},
			"uci": [ "familywarden" ]
		},
		"write": {
			"ubus": {
				"familywarden": [ "block", "allow", "reset", "ticket", "bonus", "pact", "reload", "device_approve", "device_reject", "device_update", "device_delete", "device_allow_removal", "request_answer", "app_decision", "dns_sync", "dns_auth" ]
			},
			"uci": [ "familywarden" ]
		}
	}
}
